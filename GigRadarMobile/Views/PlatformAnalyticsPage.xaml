<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             x:Class="GigRadarMobile.Views.PlatformAnalyticsPage"
             x:DataType="vm:PlatformAnalyticsViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Statistik Platform">

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
        <ScrollView>
            <VerticalStackLayout Padding="20,18,20,28" Spacing="16">

                <Border Style="{StaticResource PageHero}" HeightRequest="160">
                    <Grid>
                        <Image Source="art_prism" Aspect="AspectFill"/>
                        <BoxView Background="{StaticResource PosterScrim}"/>
                        <BoxView WidthRequest="5" HorizontalOptions="Start" Background="{StaticResource HeroGradient}"/>
                        <VerticalStackLayout Padding="16" Spacing="4" VerticalOptions="End">
                            <Label Text="ADMIN" Style="{StaticResource Overline}" TextColor="{StaticResource StageViolet}"/>
                            <Label Text="Statistik Platform" Style="{StaticResource HeroTitle}" FontSize="24"/>
                            <Label Text="Ringkasan ekosistem GigRadar — users, konten, dan antrean moderasi."
                                   Style="{StaticResource Body}" FontSize="12"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>

                <Label Text="{Binding StatusMessage}" Style="{StaticResource Body}" TextColor="{StaticResource DangerColor}"
                       IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"/>

                <!-- Komunitas -->
                <Label Text="KOMUNITAS" Style="{StaticResource Eyebrow}"/>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Frame Grid.Column="0" Style="{StaticResource Card}">
                        <Frame.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectCommunityCommand}" CommandParameter="Users"/></Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Stats.TotalUsers}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}"/>
                            <Label Text="Users" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="1" Style="{StaticResource Card}">
                        <Frame.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectCommunityCommand}" CommandParameter="Artists"/></Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Stats.TotalArtists}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource AccentColor}"/>
                            <Label Text="Artists" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Style="{StaticResource Card}">
                        <Frame.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectCommunityCommand}" CommandParameter="EO"/></Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Stats.TotalEos}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource WarningColor}"/>
                            <Label Text="EO" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <Frame Style="{StaticResource Card}" IsVisible="{Binding HasCommunities}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding SelectedCommunityLabel}" Style="{StaticResource Subheading}"/>
                                <Label Text="Ketuk kartu komunitas untuk mengganti data yang ditampilkan." Style="{StaticResource Caption}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding Stats.TotalUsers}" IsVisible="{Binding IsUsersSelected}" Style="{StaticResource Subheading}" TextColor="{StaticResource PrimaryColor}"/>
                            <Label Grid.Column="1" Text="{Binding Stats.TotalArtists}" IsVisible="{Binding IsArtistsSelected}" Style="{StaticResource Subheading}" TextColor="{StaticResource AccentColor}"/>
                            <Label Grid.Column="1" Text="{Binding Stats.TotalEos}" IsVisible="{Binding IsEosSelected}" Style="{StaticResource Subheading}" TextColor="{StaticResource WarningColor}"/>
                        </Grid>
                        <VerticalStackLayout IsVisible="{Binding IsUsersSelected}" BindableLayout.ItemsSource="{Binding Communities.Users}" Spacing="0">
                            <BindableLayout.ItemTemplate><DataTemplate x:DataType="models:CommunityUser">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,8" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2"><Label Text="{Binding Name}" Style="{StaticResource Subheading}" FontSize="14"/><Label Text="{Binding Email}" Style="{StaticResource Caption}"/><Label Text="{Binding JoinedLabel}" Style="{StaticResource Meta}"/></VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding City}" Style="{StaticResource Meta}" VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate></BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <VerticalStackLayout IsVisible="{Binding IsArtistsSelected}" BindableLayout.ItemsSource="{Binding Communities.Artists}" Spacing="0">
                            <BindableLayout.ItemTemplate><DataTemplate x:DataType="models:CommunityArtist">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,8" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2"><Label Text="{Binding Name}" Style="{StaticResource Subheading}" FontSize="14"/><Label Text="{Binding AccountEmail}" Style="{StaticResource Caption}"/><Label Text="{Binding Genre}" Style="{StaticResource Meta}"/></VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding VerificationLabel}" Style="{StaticResource Meta}" TextColor="{StaticResource AccentColor}" VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate></BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <VerticalStackLayout IsVisible="{Binding IsEosSelected}" BindableLayout.ItemsSource="{Binding Communities.Eos}" Spacing="0">
                            <BindableLayout.ItemTemplate><DataTemplate x:DataType="models:CommunityOrganizer">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,8" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2"><Label Text="{Binding Name}" Style="{StaticResource Subheading}" FontSize="14"/><Label Text="{Binding AccountEmail}" Style="{StaticResource Caption}"/><Label Text="{Binding Location}" Style="{StaticResource Meta}"/></VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding VerificationLabel}" Style="{StaticResource Meta}" TextColor="{StaticResource WarningColor}" VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate></BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Event & tiket -->
                <Label Text="EVENT &amp; TIKET" Style="{StaticResource Eyebrow}"/>
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Frame Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Stats.TotalEvents}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Total event" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Stats.ActiveEvents}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource SuccessColor}"/>
                            <Label Text="Event aktif" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Stats.TotalTickets}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource WarningColor}"/>
                            <Label Text="Tiket terjual" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Stats.TotalRevenueFormatted}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" LineBreakMode="TailTruncation"/>
                            <Label Text="Total pendapatan" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Antrean moderasi -->
                <Label Text="ANTREAN MODERASI" Style="{StaticResource Eyebrow}"/>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Frame Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Stats.PendingVerificationsLabel}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource WarningColor}"/>
                            <Label Text="Verifikasi menunggu" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Stats.OpenReports}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource DangerColor}"/>
                            <Label Text="Laporan terbuka" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Stats.PendingEoVerifications}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource AccentColor}"/>
                            <Label Text="Verifikasi EO" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
