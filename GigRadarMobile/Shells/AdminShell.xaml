<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:GigRadarMobile.Views"
       x:Class="GigRadarMobile.Shells.AdminShell"
       Shell.FlyoutBehavior="Disabled"
       Title="GigRadar Admin">

    <!-- GIGRADAR_APP_SPEC.md Bab 55/17 — AdminShell
         (Artists/EO/Settings menyusul di fase lanjut — lihat spec) -->
    <TabBar>
        <ShellContent Title="Dashboard" ContentTemplate="{DataTemplate views:EoProfilePage}" Route="dashboard"/>
        <ShellContent Title="Events" ContentTemplate="{DataTemplate views:EoEventsPage}" Route="admin-events"/>
        <ShellContent Title="Tickets" ContentTemplate="{DataTemplate views:ManageTicketsPage}" Route="admin-tickets"/>
        <ShellContent Title="Verifikasi" ContentTemplate="{DataTemplate views:VerificationsPage}" Route="admin-verifications"/>
        <ShellContent Title="Users" ContentTemplate="{DataTemplate views:UsersPage}" Route="admin-users"/>
        <ShellContent Title="Laporan" ContentTemplate="{DataTemplate views:ReportsPage}" Route="admin-reports"/>
        <ShellContent Title="Analitik" ContentTemplate="{DataTemplate views:PlatformAnalyticsPage}" Route="admin-analytics"/>
                <ShellContent Title="Notifikasi" ContentTemplate="{DataTemplate views:NotificationsPage}" Route="adminshell-notifications"/>
<ShellContent Title="Profile" ContentTemplate="{DataTemplate views:ProfilePage}" Route="profile"/>
    </TabBar>

</Shell>