<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             x:Class="GigRadarMobile.Views.ExplorePage"
             x:DataType="vm:ExploreViewModel"
             Shell.NavBarIsVisible="False"
             Title="Explore">

    <Grid RowDefinitions="Auto,*">

        <!-- ===== Header: search + filter + view switcher ===== -->
        <VerticalStackLayout Grid.Row="0" Padding="20,16,20,4" Spacing="12">
            <VerticalStackLayout Spacing="2">
                <Label Text="EXPLORE" Style="{StaticResource Eyebrow}"/>
                <Label Text="Cari gig, artis, venue" Style="{StaticResource PageTitle}"/>
            </VerticalStackLayout>

            <!-- Search -->
            <Border BackgroundColor="{StaticResource CardElevatedColor}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 12" Padding="12,2">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="⌕" FontFamily="SpaceGroteskMedium" FontSize="20"
                           TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                    <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="Event, artist, atau venue…"
                           BackgroundColor="Transparent" HeightRequest="42" FontSize="14"
                           ReturnCommand="{Binding SearchCommand}" ReturnCommandParameter="x"/>
                </Grid>
            </Border>

            <!-- Genre chips -->
            <CollectionView ItemsSource="{Binding GenreFilters}" HeightRequest="40"
                            ItemsLayout="HorizontalList" HorizontalScrollBarVisibility="Never">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GenreFilterItem">
                        <Button Text="{Binding Name}" Margin="0,0,8,0" Padding="16,8" HeightRequest="38"
                                CornerRadius="999" FontSize="13" FontFamily="InterMedium"
                                BackgroundColor="{StaticResource CardElevatedColor}"
                                TextColor="{StaticResource TextSecondary}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=SelectGenreCommand}"
                                CommandParameter="{Binding Name}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                    <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Tanggal + radius -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Semua" Style="{StaticResource Chip}" Command="{Binding SelectDateCommand}" CommandParameter="Semua">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding DateFilter}" Value="Semua">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Malam ini" Style="{StaticResource Chip}" Command="{Binding SelectDateCommand}" CommandParameter="Malam ini">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding DateFilter}" Value="Malam ini">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Akhir pekan" Style="{StaticResource Chip}" Command="{Binding SelectDateCommand}" CommandParameter="Akhir pekan">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding DateFilter}" Value="Akhir pekan">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <BoxView WidthRequest="8" Color="Transparent"/>
                    <Button Text="10 km" Style="{StaticResource Chip}" Command="{Binding SelectRadiusCommand}" CommandParameter="10 km">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding RadiusKm}" Value="10">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="25 km" Style="{StaticResource Chip}" Command="{Binding SelectRadiusCommand}" CommandParameter="25 km">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding RadiusKm}" Value="25">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="50 km" Style="{StaticResource Chip}" Command="{Binding SelectRadiusCommand}" CommandParameter="50 km">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding RadiusKm}" Value="50">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- View switcher -->
            <Border BackgroundColor="{StaticResource SurfaceColor}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 12" Padding="4">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                    <Button Grid.Column="0" Text="List" FontSize="13" FontFamily="InterSemiBold" HeightRequest="40"
                            CornerRadius="9" BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                            Command="{Binding SetViewModeCommand}" CommandParameter="List">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ViewMode}" Value="List">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="Grid" FontSize="13" FontFamily="InterSemiBold" HeightRequest="40"
                            CornerRadius="9" BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                            Command="{Binding SetViewModeCommand}" CommandParameter="Grid">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ViewMode}" Value="Grid">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2" Text="Radar" FontSize="13" FontFamily="InterSemiBold" HeightRequest="40"
                            CornerRadius="9" BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                            Command="{Binding SetViewModeCommand}" CommandParameter="Radar">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ViewMode}" Value="Radar">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- ===== Body ===== -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,28" Spacing="20">

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>

                <!-- Error state -->
                <Frame IsVisible="{Binding HasError}" BackgroundColor="{StaticResource DangerSoft}"
                       BorderColor="{StaticResource BorderColor}" CornerRadius="14" Padding="14" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource Body}" TextColor="{StaticResource DangerColor}"/>
                        <Button Text="Coba lagi" Style="{StaticResource BtnOutline}" HeightRequest="42"
                                Command="{Binding RetryCommand}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Hasil header -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding HasResults}">
                    <Label Text="{Binding ResultCountLabel}" Style="{StaticResource Caption}" VerticalOptions="Center"/>
                    <Button Grid.Column="1" Text="Bersihkan" Style="{StaticResource TextLink}" IsVisible="{Binding IsFiltered}"
                            Command="{Binding ClearFiltersCommand}"/>
                </Grid>

                <!-- LIST view (juga tampil di Radar — radar bukan satu-satunya akses info) -->
                <VerticalStackLayout Spacing="2" IsVisible="{Binding IsEventListVisible}">
                    <CollectionView ItemsSource="{Binding Events}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:GigEvent">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="0,9">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=GoToDetailCommand}" CommandParameter="{Binding .}"/>
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center" WidthRequest="44">
                                        <Label Text="{Binding StartDate, StringFormat='{0:dd}'}" Style="{StaticResource Numeric}" FontSize="22" HorizontalTextAlignment="Center"/>
                                        <Label Text="{Binding StartDate, StringFormat='{0:MMM}'}" FontSize="9" FontAttributes="Bold" CharacterSpacing="1"
                                               TextColor="{StaticResource TextMuted}" HorizontalTextAlignment="Center"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" Style="{StaticResource Subheading}" MaxLines="1" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding VenueName}" Style="{StaticResource Caption}" MaxLines="1" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding TimeFormatted}" Style="{StaticResource Meta}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding PriceFormatted}" Style="{StaticResource Numeric}" FontSize="13"
                                           TextColor="{StaticResource PrimaryColor}" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- GRID view (tinggi proporsional, bukan 600 fix — scroll mengikuti isi) -->
                <CollectionView IsVisible="{Binding IsGridView}" ItemsSource="{Binding Events}" SelectionMode="None"
                                HeightRequest="{Binding GridHeight}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:GigEvent">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{StaticResource CardColor}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=GoToDetailCommand}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="8">
                                    <Image Source="{Binding PosterUrl, Converter={StaticResource PosterImageConverter}}"
                                           Aspect="AspectFill" HeightRequest="92"/>
                                    <VerticalStackLayout Padding="10,0,10,12" Spacing="2">
                                        <Label Text="{Binding Name}" Style="{StaticResource Subheading}" FontSize="13"
                                               MaxLines="2" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding VenueName}" Style="{StaticResource Meta}" MaxLines="1" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding DateFormatted}" Style="{StaticResource Meta}"/>
                                        <Label Text="{Binding PriceFormatted}" Style="{StaticResource Numeric}" FontSize="12"
                                               TextColor="{StaticResource PrimaryColor}"/>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- RADAR view -->
                <VerticalStackLayout Spacing="14" IsVisible="{Binding IsRadarView}">
                    <Border BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="12">
                        <Grid>
                            <GraphicsView x:Name="ExploreRadarView" HeightRequest="330"
                                          StartInteraction="OnRadarStartInteraction"/>
                            <VerticalStackLayout Padding="14,12" Spacing="2" HorizontalOptions="Start" VerticalOptions="Start">
                                <Label Text="RADAR" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.4"
                                       TextColor="{StaticResource TextMuted}"/>
                                <Label Text="{Binding RadiusKm, StringFormat='Radius {0:0} km'}" FontSize="10" TextColor="{StaticResource TextMuted}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Label Text="Tap titik untuk lihat detail. Warna = genre, ukuran = popularitas."
                           Style="{StaticResource Meta}" HorizontalTextAlignment="Center"/>

                    <Border IsVisible="{Binding HasSelection}" BackgroundColor="{StaticResource CardColor}"
                            Stroke="{StaticResource BorderStrong}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center" WidthRequest="44">
                                    <Label Text="{Binding SelectedDay}" Style="{StaticResource Numeric}" FontSize="24" HorizontalTextAlignment="Center"/>
                                    <Label Text="{Binding SelectedMonth}" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"
                                           TextColor="{StaticResource TextMuted}" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding SelectedName}" Style="{StaticResource Subheading}" MaxLines="2" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding SelectedMeta}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding SelectedDistance}" Style="{StaticResource Meta}" TextColor="{StaticResource PrimaryColor}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding SelectedPrice}" Style="{StaticResource Numeric}" FontSize="14"
                                       TextColor="{StaticResource PrimaryColor}" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                            </Grid>
                            <Button Text="Lihat detail" Style="{StaticResource BtnSmall}"
                                    BackgroundColor="{StaticResource PrimaryColor}" TextColor="{StaticResource OnAccent}"
                                    HorizontalOptions="End" Command="{Binding GoToSelectedCommand}"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Artist results -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasArtists}">
                    <Label Text="Artis" Style="{StaticResource SectionTitle}"/>
                    <CollectionView ItemsSource="{Binding Artists}" HeightRequest="76" ItemsLayout="HorizontalList"
                                    HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Artist">
                                <Border Margin="0,0,10,0" StrokeThickness="0" StrokeShape="RoundRectangle 999"
                                        BackgroundColor="{StaticResource CardElevatedColor}" Padding="8,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=GoToArtistCommand}" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource SurfaceColor}">
                                            <Label Text="{Binding Initials}" FontFamily="SpaceGroteskBold" FontSize="12"
                                                   TextColor="{StaticResource PrimaryColor}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" Style="{StaticResource Subheading}" FontSize="14" MaxLines="1" LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding Genre}" Style="{StaticResource Meta}" FontSize="10"/>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Venue results -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasVenues}">
                    <Label Text="Venue" Style="{StaticResource SectionTitle}"/>
                    <CollectionView ItemsSource="{Binding Venues}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Venue">
                                <Border Style="{StaticResource CardFlatBorder}" Padding="14" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Name}" Style="{StaticResource Subheading}" FontSize="14" MaxLines="1" LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding City}" Style="{StaticResource Meta}"/>
                                            <Label Text="{Binding Address}" Style="{StaticResource Meta}" FontSize="10" MaxLines="1" LineBreakMode="TailTruncation"/>
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="Peta" Style="{StaticResource BtnSmall}" Padding="12,4"
                                                HeightRequest="30" FontSize="11" BackgroundColor="Transparent"
                                                TextColor="{StaticResource TextMuted}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=OpenVenueMapCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Empty state -->
                <Label Text="{Binding EmptyMessage}" Style="{StaticResource Body}" Margin="0,24,0,0"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding HasResults, Converter={StaticResource InvertedBoolConverter}}"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>