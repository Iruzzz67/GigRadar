<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             x:Class="GigRadarMobile.Views.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Notifikasi">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,18,20,16" RowSpacing="12">

        <Border Grid.Row="0" Style="{StaticResource PageHero}" HeightRequest="130">
            <Grid>
                <Image Source="art_ripple" Aspect="AspectFill"/>
                <BoxView Background="{StaticResource PosterScrim}"/>
                <BoxView WidthRequest="5" HorizontalOptions="Start" Background="{StaticResource SignalGradient}"/>
                <Grid Padding="16" ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="End">
                    <VerticalStackLayout Spacing="4" VerticalOptions="End">
                        <Label Text="GIGRADAR" Style="{StaticResource Overline}" TextColor="{StaticResource PrimaryColor}"/>
                        <Label Text="Notifikasi" Style="{StaticResource HeroTitle}" FontSize="24"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Tandai dibaca" Style="{StaticResource BtnOutline}" HeightRequest="40"
                            IsVisible="{Binding HasUnread}" Command="{Binding MarkAllReadCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>

        <!-- Empty state -->
        <Frame Grid.Row="2" IsVisible="{Binding HasNotifications, Converter={StaticResource InvertedBoolConverter}}"
               BackgroundColor="{StaticResource CardColor}" BorderColor="{StaticResource BorderColor}"
               CornerRadius="14" Padding="18" HasShadow="False" VerticalOptions="Start">
            <VerticalStackLayout Spacing="6">
                <Label Text="BELUM ADA NOTIFIKASI" Style="{StaticResource Eyebrow}"/>
                <Label Text="Kabarem tentang undangan, verifikasi, tiket, dan aktivitas artist akan muncul di sini."
                       Style="{StaticResource Body}" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
            </VerticalStackLayout>
        </Frame>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:NotificationItem">
                        <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,2">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" WidthRequest="38" HeightRequest="38" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource CardElevatedColor}">
                                    <Label Text="{Binding TypeIcon}" FontSize="16"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Title}" Style="{StaticResource Subheading}" FontSize="14"/>
                                    <Label Text="{Binding Body}" Style="{StaticResource Caption}" FontSize="12"
                                           TextColor="{StaticResource TextSecondary}"/>
                                    <Label Text="{Binding CreatedAtDisplay}" Style="{StaticResource Meta}" FontSize="10"
                                           TextColor="{StaticResource TextMuted}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="Dibaca" FontSize="10" HeightRequest="30" Padding="8,0"
                                        CornerRadius="8" IsVisible="{Binding IsUnread}"
                                        BackgroundColor="{StaticResource AccentSoft}" TextColor="{StaticResource PrimaryColor}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=MarkReadCommand, x:DataType={x:Type vm:NotificationsViewModel}}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
