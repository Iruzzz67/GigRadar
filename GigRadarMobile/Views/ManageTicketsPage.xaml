<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             x:Class="GigRadarMobile.Views.ManageTicketsPage"
             x:DataType="vm:ManageTicketsViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Kelola Tiket">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,28" Spacing="16">

            <VerticalStackLayout Spacing="4">
                <Label Text="TICKET TYPES" Style="{StaticResource Eyebrow}"/>
                <Label Text="Kelola tiket &amp; stok" Style="{StaticResource PageTitle}"/>
                <Label Text="Pilih event untuk menambah, mengedit, atau menghapus tipe tiket dan stoknya."
                       Style="{StaticResource PageSubtitle}"/>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>
            <Label Text="{Binding StatusMessage}" Style="{StaticResource Body}" TextColor="{StaticResource DangerColor}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"/>

            <CollectionView ItemsSource="{Binding Events}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ManagedEventItem">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="14">
                            <VerticalStackLayout Spacing="10">

                                <!-- Header event (tap untuk expand) -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="{Binding Event.Name}" Style="{StaticResource Subheading}"
                                               MaxLines="2" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding DateLabel}" Style="{StaticResource Caption}"/>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" VerticalOptions="Center" Text="▼" FontSize="12"
                                            BackgroundColor="{StaticResource CardElevatedColor}" TextColor="{StaticResource PrimaryColor}"
                                            CornerRadius="8" HeightRequest="44" Padding="12,0"
                                            SemanticProperties.Description="Buka atau tutup daftar tipe tiket event ini"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ManageTicketsViewModel}}, Path=ToggleEventCommand}"
                                            CommandParameter="{Binding .}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsExpanded}" Value="False">
                                                <Setter Property="Text" Value="▶"/>
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>

                                <!-- Isi saat di-expand -->
                                <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="8">

                                    <ActivityIndicator IsRunning="{Binding IsLoadingTypes}" IsVisible="{Binding IsLoadingTypes}" HeightRequest="24"/>

                                    <Label Text="Belum ada tipe tiket untuk event ini."
                                           IsVisible="{Binding Types.Count, Converter={StaticResource IsZeroConverter}}"
                                           Style="{StaticResource Body}"/>

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Types}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:EventTicketType">
                                                <Border BackgroundColor="{StaticResource CardElevatedColor}" StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 10" Padding="12">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                        <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                                            <Label Text="{Binding Name}" Style="{StaticResource Subheading}" FontSize="14"/>
                                                            <Label Text="{Binding Description}" Style="{StaticResource Meta}" FontSize="11"
                                                                   MaxLines="1" LineBreakMode="TailTruncation"
                                                                   IsVisible="{Binding Description, Converter={StaticResource StringNotEmptyConverter}}"/>
                                                        </VerticalStackLayout>
                                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" HorizontalOptions="End">
                                                            <Label Text="{Binding PriceFormatted}" Style="{StaticResource Numeric}" FontSize="13"
                                                                   TextColor="{StaticResource PrimaryColor}" HorizontalTextAlignment="End"/>
                                                            <Label Text="{Binding StockLabel}" Style="{StaticResource Meta}" FontSize="11"
                                                                   TextColor="{Binding StockColor}" HorizontalTextAlignment="End"/>
                                                        </VerticalStackLayout>
                                                        <VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                                            <Button Text="Edit" FontSize="12" HeightRequest="36" Padding="12,0"
                                                                    BackgroundColor="{StaticResource SurfaceColor}" TextColor="{StaticResource TextPrimary}"
                                                                    CornerRadius="8"
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ManageTicketsViewModel}}, Path=EditTypeCommand}"
                                                                    CommandParameter="{Binding .}"/>
                                                            <Button Text="Hapus" FontSize="12" HeightRequest="36" Padding="12,0"
                                                                    BackgroundColor="{StaticResource DangerSoft}" TextColor="{StaticResource DangerColor}"
                                                                    CornerRadius="8"
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ManageTicketsViewModel}}, Path=DeleteTypeCommand}"
                                                                    CommandParameter="{Binding .}"/>
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <Button Text="+ Tambah tipe tiket" Style="{StaticResource BtnOutline}" HeightRequest="42" FontSize="13"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ManageTicketsViewModel}}, Path=ShowAddTypeCommand}"
                                            CommandParameter="{Binding .}"/>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Form tambah / edit tipe tiket -->
            <Border IsVisible="{Binding IsFormVisible}" Style="{StaticResource CardBorder}" Margin="0,8,0,0"
                    Stroke="{StaticResource BorderStrong}" StrokeThickness="1">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding FormTitle}" Style="{StaticResource Subheading}" TextColor="{StaticResource PrimaryColor}"/>

                    <Entry Text="{Binding FormName}" Placeholder="Nama tipe (mis. Festival / Tribun / Bundling)"/>
                    <Entry Text="{Binding FormDescription}" Placeholder="Deskripsi (opsional)"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Entry Grid.Column="0" Text="{Binding FormPrice}" Placeholder="Harga (Rp)" Keyboard="Numeric"/>
                        <Entry Grid.Column="1" Text="{Binding FormStock}" Placeholder="Stok" Keyboard="Numeric"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="Batal" Style="{StaticResource BtnDark}" HeightRequest="46"
                                Command="{Binding CancelFormCommand}"/>
                        <Button Grid.Column="1" Text="Simpan" Style="{StaticResource BtnPrimary}" HeightRequest="46"
                                Command="{Binding SaveTypeCommand}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>