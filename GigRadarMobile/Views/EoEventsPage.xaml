<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             x:Class="GigRadarMobile.Views.EoEventsPage"
             x:DataType="vm:EoEventsViewModel"
             BackgroundColor="#121212"
             Title="Events">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="Event yang Dikelola" FontSize="20" FontAttributes="Bold" TextColor="White"/>
            <Label Text="EO melihat event miliknya; Admin melihat semua event." FontSize="12" TextColor="#B0B0B0"/>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#39FF14"/>
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   TextColor="#FF6B6B" FontSize="13" HorizontalTextAlignment="Center"/>

            <Button Text="➕ Buat Event Baru" BackgroundColor="#39FF14" TextColor="Black" FontAttributes="Bold"
                    CornerRadius="10" HeightRequest="48" Command="{Binding GoToCreateEventCommand}"/>

            <Label Text="Belum ada event. Event yang kamu buat akan muncul di sini."
                   IsVisible="{Binding HasEvents, Converter={StaticResource InvertedBoolConverter}}"
                   TextColor="#B0B0B0" FontSize="13"/>

            <CollectionView ItemsSource="{Binding Dashboard.Events}" SelectionMode="None" IsVisible="{Binding HasEvents}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:EoEventStat">
                        <Frame BackgroundColor="#1E1E1E" CornerRadius="12" Padding="14" Margin="0,4"
                               BorderColor="#333333" HasShadow="False">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="15" FontAttributes="Bold"
                                           TextColor="White" LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="1" Text="{Binding StatusLabel}" FontSize="11" FontAttributes="Bold"
                                           TextColor="{Binding StatusColor}" VerticalOptions="Center"/>
                                </Grid>
                                <Label Text="{Binding DateLabel}" FontSize="12" TextColor="#B0B0B0"/>
                                <BoxView HeightRequest="1" Color="#2A2A2A"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding SoldLabel}" FontSize="12" TextColor="#FFB020"/>
                                        <Label Text="{Binding TicketTypeCount, StringFormat='{0} tipe tiket'}" FontSize="11" TextColor="#B0B0B0"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                        <Label Text="{Binding RevenueFormatted}" FontSize="14" FontAttributes="Bold"
                                               TextColor="#39FF14" HorizontalTextAlignment="End"/>
                                        <Label Text="Pendapatan" FontSize="11" TextColor="#B0B0B0" HorizontalTextAlignment="End"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <BoxView HeightRequest="1" Color="#2A2A2A"/>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Button Grid.Column="0" Text="{Binding PrimaryActionLabel}" FontSize="12" FontAttributes="Bold"
                                            HeightRequest="38" CornerRadius="8" Padding="8,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EoEventsViewModel}}, Path=TogglePrimaryActionCommand}"
                                            CommandParameter="{Binding .}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="BackgroundColor" Value="#39FF14"/>
                                                <Setter Property="TextColor" Value="Black"/>
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding Status}" Value="Published">
                                                        <Setter Property="BackgroundColor" Value="#B34700"/>
                                                        <Setter Property="TextColor" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="1" Text="✅ Selesai" FontSize="12" FontAttributes="Bold" HeightRequest="38"
                                            CornerRadius="8" Padding="12,0" BackgroundColor="#2A2A2A" TextColor="#B0B0B0"
                                            IsVisible="{Binding CanMarkCompleted}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EoEventsViewModel}}, Path=MarkCompletedCommand}"
                                            CommandParameter="{Binding .}"/>
                                    <Button Grid.Column="2" Text="&#x1F5D1;&#xFE0F;" FontSize="12" HeightRequest="38" WidthRequest="44" CornerRadius="8"
                                            BackgroundColor="#3A2020" TextColor="#FF6B6B"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EoEventsViewModel}}, Path=DeleteEventCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>