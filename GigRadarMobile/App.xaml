<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:GigRadarMobile.Helpers"
             x:Class="GigRadarMobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <helpers:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
            <helpers:IsZeroConverter x:Key="IsZeroConverter"/>
            <helpers:BarcodeDrawableConverter x:Key="BarcodeDrawableConverter"/>
            <helpers:PosterImageConverter x:Key="PosterImageConverter"/>
            <helpers:BoolToOpacityConverter x:Key="SoldOutOpacityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>