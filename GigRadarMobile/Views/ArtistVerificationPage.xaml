<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             x:Class="GigRadarMobile.Views.ArtistVerificationPage"
             x:DataType="vm:ArtistVerificationViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Verifikasi Artist">

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
        <ScrollView>
            <VerticalStackLayout Padding="20,18,20,28" Spacing="16">

                <!-- Header -->
                <Border Style="{StaticResource PageHero}" HeightRequest="150">
                    <Grid>
                        <Image Source="art_monolith" Aspect="AspectFill"/>
                        <BoxView Background="{StaticResource PosterScrim}"/>
                        <BoxView WidthRequest="5" HorizontalOptions="Start" Background="{StaticResource SignalGradient}"/>
                        <VerticalStackLayout Padding="16" Spacing="4" VerticalOptions="End">
                            <Label Text="ARTIST" Style="{StaticResource Overline}" TextColor="{StaticResource PrimaryColor}"/>
                            <Label Text="Verifikasi" Style="{StaticResource HeroTitle}" FontSize="26"/>
                            <Label Text="Verifikasi membuat profil kamu lebih dipercaya oleh penonton dan Event Organizer."
                                   Style="{StaticResource Body}" FontSize="12"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>

                <Label Text="{Binding StatusMessage}" Style="{StaticResource Body}"
                       TextColor="{StaticResource DangerColor}"
                       IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"/>

                <!-- Status card -->
                <Frame IsVisible="{Binding HasStatus}" BackgroundColor="{StaticResource CardColor}"
                       BorderColor="{StaticResource BorderColor}" CornerRadius="14" Padding="16" HasShadow="False">
                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="STATUS VERIFIKASI" Style="{StaticResource Eyebrow}"/>
                                <Label Text="{Binding ArtistNameDisplay}" Style="{StaticResource Subheading}"/>
                            </VerticalStackLayout>
                            <!-- Badge ✓ hanya saat server bilang IsVerified (Bab 8: Verified Badge) -->
                            <Border Grid.Column="1" IsVisible="{Binding IsVerifiedBadgeVisible}"
                                    BackgroundColor="{StaticResource AccentSoft}" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999" Padding="10,4">
                                <Label Text="✓ Terverifikasi" FontSize="12" FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryColor}"/>
                            </Border>
                        </Grid>

                        <Frame BackgroundColor="{StaticResource CardElevatedColor}" BorderColor="{StaticResource BorderColor}"
                               CornerRadius="10" Padding="12" HasShadow="False">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Border Grid.Column="0" WidthRequest="10" HeightRequest="10" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 999" VerticalOptions="Center"
                                        BackgroundColor="{Binding StatusDotColor}"/>
                                <Label Grid.Column="1" Text="{Binding StatusDisplayText}" Style="{StaticResource Body}"
                                       FontAttributes="Bold" VerticalOptions="Center"/>
                            </Grid>
                        </Frame>

                        <!-- Alasan penolakan (Bab 8: pengajuan ditolak bisa diajukan ulang) -->
                        <Frame IsVisible="{Binding HasRejectedReason}" BackgroundColor="{StaticResource DangerSoft}"
                               BorderColor="{StaticResource BorderColor}" CornerRadius="10" Padding="12" HasShadow="False">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="ALASAN PENOLAKAN" Style="{StaticResource Eyebrow}" TextColor="{StaticResource DangerColor}"/>
                                <Label Text="{Binding RejectedReasonDisplay}" Style="{StaticResource Body}" FontSize="13"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Info menunggu tinjauan -->
                        <Label IsVisible="{Binding IsPendingReview}"
                               Text="Pengajuanmu sedang ditinjau Admin. Kamu akan melihat hasilnya di halaman ini."
                               Style="{StaticResource Caption}" TextColor="{StaticResource TextSecondary}"/>

                        <!-- Riwayat pengajuan terakhir -->
                        <VerticalStackLayout Spacing="4" IsVisible="{Binding HasLatest}">
                            <Label Text="PENGAJUAN TERAKHIR" Style="{StaticResource Eyebrow}"/>
                            <Label Text="{Binding LatestSubmittedAtDisplay}" Style="{StaticResource Caption}"
                                   TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>

                        <Button Text="{Binding ToggleFormLabel}" Style="{StaticResource BtnOutline}" HeightRequest="44"
                                IsVisible="{Binding CanSubmit}" Command="{Binding ToggleFormCommand}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Form pengajuan -->
                <Frame IsVisible="{Binding IsFormVisible}" BackgroundColor="{StaticResource SurfaceColor}"
                       BorderColor="{StaticResource BorderStrong}" CornerRadius="14" Padding="16" HasShadow="False">
                    <VerticalStackLayout Spacing="12">

                        <Label Text="FORM PENGAJUAN" Style="{StaticResource Eyebrow}"/>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Nama legal / perwakilan *" Style="{StaticResource Caption}"/>
                            <Entry Text="{Binding FormLegalName}" Placeholder="Nama sesuai identitas"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="No. telepon *" Style="{StaticResource Caption}"/>
                            <Entry Text="{Binding FormPhone}" Placeholder="081234567890" Keyboard="Telephone"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Link Spotify" Style="{StaticResource Caption}"/>
                            <Entry Text="{Binding FormSpotifyUrl}" Placeholder="https://open.spotify.com/artist/..." Keyboard="Url"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Informasi pendukung" Style="{StaticResource Caption}"/>
                            <Editor Text="{Binding FormSupportingInfo}" Placeholder="Ceritakan aktivitas band, link medsos, rilisan, atau pertunjukan sebelumnya."
                                    AutoSize="TextChanges" MinimumHeightRequest="90"/>
                            <Label Text="Isi minimal salah satu: link Spotify atau informasi pendukung."
                                   Style="{StaticResource Meta}" TextColor="{StaticResource TextMuted}"/>
                        </VerticalStackLayout>

                        <Label Text="{Binding FormError}" Style="{StaticResource Meta}" TextColor="{StaticResource DangerColor}"
                               IsVisible="{Binding FormError, Converter={StaticResource StringNotEmptyConverter}}"/>

                        <Button Text="Kirim pengajuan" Style="{StaticResource BtnPrimary}" HeightRequest="46"
                                Command="{Binding SubmitCommand}"
                                IsEnabled="{Binding IsSubmitting, Converter={StaticResource InvertedBoolConverter}}"/>
                        <ActivityIndicator IsRunning="{Binding IsSubmitting}" IsVisible="{Binding IsSubmitting}" HeightRequest="20"/>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
