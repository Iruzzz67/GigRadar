<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             xmlns:behaviors="clr-namespace:GigRadarMobile.Behaviors"
             x:Class="GigRadarMobile.Views.EventDetailPage"
             x:DataType="vm:EventDetailViewModel"
             Shell.NavBarIsVisible="False"
             Title="Event Detail">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <ScrollView.Behaviors>
                <behaviors:ParallaxBehavior Target="{x:Reference DetailHeroArt}" Factor="0.35"/>
            </ScrollView.Behaviors>
            <VerticalStackLayout Spacing="0">

                <!-- ===== Hero poster ===== -->
                <Grid HeightRequest="420">
                    <Image x:Name="DetailHeroArt"
                           Source="{Binding GigEvent.PosterUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter={Binding GigEvent.Name}}"
                           Aspect="AspectFill"/>
                    <BoxView Background="{StaticResource PosterScrim}"/>
                    <BoxView HeightRequest="5" VerticalOptions="End"
                             Color="{Binding GigEvent.GenreName, Converter={StaticResource GenreAccentConverter}, ConverterParameter=accent}"/>

                    <!-- Bar aksi atas -->
                    <Grid Padding="16,12" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" VerticalOptions="Start">
                        <Button Grid.Column="0" Text="‹" FontSize="24" Padding="0" WidthRequest="44" HeightRequest="44"
                                CornerRadius="999" BackgroundColor="#CC1A1A1F" TextColor="{StaticResource TextPrimary}"
                                Command="{Binding GoBackCommand}"
                                SemanticProperties.Description="Kembali"/>
                        <Button Grid.Column="2" Text="↗" FontSize="17" Padding="0" WidthRequest="44" HeightRequest="44"
                                CornerRadius="999" BackgroundColor="#CC1A1A1F" TextColor="{StaticResource TextPrimary}"
                                Command="{Binding ShareCommand}"
                                SemanticProperties.Description="Bagikan event ini"/>
                        <Button Grid.Column="3" Text="♡" FontSize="18" Padding="0" WidthRequest="44" HeightRequest="44"
                                CornerRadius="999" BackgroundColor="#CC1A1A1F" TextColor="{StaticResource TextPrimary}"
                                Command="{Binding ToggleFavoriteCommand}"
                                SemanticProperties.Description="Simpan atau hapus event dari favorit">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsFavorited}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                    <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>

                    <!-- Info event di atas scrim -->
                    <VerticalStackLayout Padding="20,0,20,18" Spacing="10" VerticalOptions="End">
                        <HorizontalStackLayout Spacing="8">
                            <Border Style="{StaticResource Pill}"
                                    IsVisible="{Binding GigEvent.GenreName, Converter={StaticResource StringNotEmptyConverter}}">
                                <Label Text="{Binding GigEvent.GenreName}" Style="{StaticResource PillText}"/>
                            </Border>
                            <Border Style="{StaticResource Pill}" IsVisible="{Binding GigEvent.ShowsStatusBadge}"
                                    BackgroundColor="{Binding GigEvent.StatusColor}">
                                <Label Text="{Binding GigEvent.StatusLabel}" Style="{StaticResource PillTextAccent}"/>
                            </Border>
                            <Border Style="{StaticResource Pill}">
                                <Label Text="{Binding GigEvent.StartDate, Converter={StaticResource RelativeDayConverter}}"
                                       Style="{StaticResource PillText}"/>
                            </Border>
                        </HorizontalStackLayout>

                        <Label Text="{Binding GigEvent.Name}" Style="{StaticResource Display}" FontSize="30"
                               MaxLines="3" LineBreakMode="TailTruncation"/>

                        <HorizontalStackLayout Spacing="6">
                            <Label Text="{Binding GigEvent.DateFormatted}" Style="{StaticResource Caption}"/>
                            <Label Text="•" TextColor="{StaticResource TextMuted}"/>
                            <Label Text="{Binding GigEvent.TimeFormatted}" Style="{StaticResource Caption}"/>
                            <Label Text="•" TextColor="{StaticResource TextMuted}"/>
                            <Label Text="{Binding GigEvent.VenueName}" Style="{StaticResource Caption}" MaxLines="1" LineBreakMode="TailTruncation"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <!-- ===== Konten ===== -->
                <VerticalStackLayout Padding="20,24,20,28" Spacing="28">
                    <VerticalStackLayout.Behaviors>
                        <behaviors:EntranceAnimationBehavior FromOffset="20" Duration="380" AnimateScale="False"/>
                    </VerticalStackLayout.Behaviors>

                    <!-- Blok info -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatTile}">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="TANGGAL" Style="{StaticResource StatLabel}"/>
                                <Label Text="{Binding GigEvent.DateFormatted}" Style="{StaticResource Subheading}" FontSize="15"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatTile}">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="JAM" Style="{StaticResource StatLabel}"/>
                                <Label Text="{Binding GigEvent.TimeFormatted}" Style="{StaticResource Subheading}" FontSize="15"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StatTile}">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="VENUE" Style="{StaticResource StatLabel}"/>
                                <Label Text="{Binding GigEvent.VenueName}" Style="{StaticResource Subheading}" FontSize="15" MaxLines="1" LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatTile}">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="JARAK" Style="{StaticResource StatLabel}"/>
                                <Label Text="{Binding DistanceLabel}" Style="{StaticResource Subheading}" FontSize="15"
                                       TextColor="{StaticResource PrimaryColor}" MaxLines="1" LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Tentang -->
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <BoxView Style="{StaticResource SectionBar}"/>
                            <Label Text="Tentang event" Style="{StaticResource SectionTitleStrong}"/>
                        </HorizontalStackLayout>
                        <Label Text="{Binding GigEvent.Description}" Style="{StaticResource Body}" LineHeight="1.35"/>
                    </VerticalStackLayout>

                    <!-- Lineup -->
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <HorizontalStackLayout Grid.Column="0" Spacing="10">
                                <BoxView Style="{StaticResource SectionBar}"/>
                                <Label Text="Lineup" Style="{StaticResource SectionTitleStrong}"/>
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="{Binding PlaybackStatus}" Style="{StaticResource Meta}"
                                   TextColor="{StaticResource PrimaryColor}" VerticalOptions="Center"
                                   IsVisible="{Binding PlaybackStatus, Converter={StaticResource StringNotEmptyConverter}}"/>
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding GigEvent.EventArtists}" Spacing="2">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:EventArtist">
                                    <Border Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                        <Grid Grid.Column="0" WidthRequest="44" HeightRequest="44">
                                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 999" Padding="0">
                                                <Image Source="{Binding Artist.PhotoUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter={Binding Artist.Name}}"
                                                       Aspect="AspectFill"/>
                                            </Border>
                                            <BoxView Color="#990B0A0E" />
                                            <Label Text="{Binding Artist.Initials}" FontFamily="SpaceGroteskBold" FontSize="13"
                                                   TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Grid>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding Artist.Name}" Style="{StaticResource Subheading}" MaxLines="1" LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding Artist.Genre}" Style="{StaticResource Meta}"/>
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" Text="▶" FontSize="12" Padding="0" WidthRequest="40" HeightRequest="40"
                                                CornerRadius="999" BackgroundColor="{StaticResource AccentSoft}" TextColor="{StaticResource PrimaryColor}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EventDetailViewModel}}, Path=PlayPreviewCommand, x:DataType={x:Type vm:EventDetailViewModel}}"
                                                CommandParameter="{Binding Artist}"/>
                                        <Button Grid.Column="3" Text="›" FontSize="20" Padding="0" WidthRequest="40" HeightRequest="40"
                                                BackgroundColor="Transparent" TextColor="{StaticResource TextMuted}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EventDetailViewModel}}, Path=GoToArtistCommand, x:DataType={x:Type vm:EventDetailViewModel}}"
                                                CommandParameter="{Binding Artist}"/>
                                    </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Tiket -->
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10">
                            <BoxView Style="{StaticResource SectionBar}"/>
                            <Label Text="Tiket" Style="{StaticResource SectionTitleStrong}"/>
                        </HorizontalStackLayout>

                        <!-- Link eksternal -->
                        <Border IsVisible="{Binding GigEvent.HasExternalLink}" Style="{StaticResource CardFlatBorder}" Padding="16">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Tiket dijual di platform partner" Style="{StaticResource Subheading}"/>
                                <Label Text="Kamu akan diarahkan ke link pembelian resmi event ini."
                                       Style="{StaticResource Body}"/>
                                <Label Text="{Binding GigEvent.TicketLink}" Style="{StaticResource Meta}" MaxLines="1" LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Tier tiket dari API -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding TicketTypes}"
                                             Spacing="8" IsVisible="{Binding HasTicketTypes}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:EventTicketType">
                                    <Border BackgroundColor="{StaticResource CardColor}" Stroke="{StaticResource BorderColor}"
                                            StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="0">
                                      <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="12">
                                        <BoxView Grid.Column="0" Background="{StaticResource SignalGradient}"/>
                                        <VerticalStackLayout Grid.Column="1" Padding="0,14" Spacing="4">
                                                <Label Text="{Binding Name}" Style="{StaticResource Subheading}"/>
                                                <Label Text="{Binding Description}" Style="{StaticResource Body}" FontSize="12"
                                                       MaxLines="2" LineBreakMode="TailTruncation" IsVisible="{Binding Description, Converter={StaticResource StringNotEmptyConverter}}"/>
                                                <Label Text="{Binding StockLabel}" Style="{StaticResource Meta}" TextColor="{Binding StockColor}"/>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding PriceFormatted}" Style="{StaticResource Numeric}"
                                                   FontSize="15" TextColor="{StaticResource PrimaryColor}" VerticalOptions="Center"
                                                   Margin="0,0,14,0" LineBreakMode="TailTruncation"/>
                                      </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Fallback harga -->
                        <Border IsVisible="{Binding ShowPriceFallback}" Style="{StaticResource CardFlatBorder}" Padding="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="Harga tiket" Style="{StaticResource Subheading}" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding GigEvent.PriceFormatted}" Style="{StaticResource Numeric}"
                                       FontSize="15" TextColor="{StaticResource PrimaryColor}"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Venue -->
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10">
                            <BoxView Style="{StaticResource SectionBar}"/>
                            <Label Text="Venue" Style="{StaticResource SectionTitleStrong}"/>
                        </HorizontalStackLayout>
                        <Border Style="{StaticResource CardBorder}" Padding="16">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding GigEvent.VenueName}" Style="{StaticResource Subheading}"/>
                                <Label Text="{Binding GigEvent.Venue.Address}" Style="{StaticResource Body}" FontSize="13"
                                       MaxLines="2" LineBreakMode="TailTruncation"/>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding GigEvent.Venue.City}" Style="{StaticResource Meta}"/>
                                    <Label Text="•" TextColor="{StaticResource TextMuted}"/>
                                    <Label Text="{Binding GigEvent.Venue.Capacity, StringFormat='Kapasitas {0}'}" Style="{StaticResource Meta}"/>
                                </HorizontalStackLayout>
                                <Button Text="Buka peta" Style="{StaticResource BtnSmall}" BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextSecondary}" BorderColor="{StaticResource BorderStrong}" BorderWidth="1"
                                        HorizontalOptions="Start" Command="{Binding OpenMapsCommand}"/>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== Sticky buy bar ===== -->
        <Border Grid.Row="1" StrokeThickness="0,1,0,0" Stroke="{StaticResource BorderColor}"
                BackgroundColor="{StaticResource BackgroundColor}" Padding="20,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding PriceCaption}" Style="{StaticResource Meta}"/>
                    <Label Text="{Binding PriceFromLabel}" Style="{StaticResource Numeric}" FontSize="17"
                           TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation"/>
                    <Label Text="{Binding TicketHint}" Style="{StaticResource Meta}" FontSize="11"
                           TextColor="{StaticResource DangerColor}" MaxLines="2" LineBreakMode="WordWrap"
                           IsVisible="{Binding TicketHint, Converter={StaticResource StringNotEmptyConverter}}"/>
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="{Binding BuyButtonText}" Style="{StaticResource BtnBuy}"
                        WidthRequest="190" IsEnabled="{Binding CanBuy}"
                        Command="{Binding BuyTicketCommand}"/>
            </Grid>
        </Border>

    </Grid>

</ContentPage>
