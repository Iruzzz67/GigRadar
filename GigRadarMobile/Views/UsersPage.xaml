<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             xmlns:services="clr-namespace:GigRadarMobile.Services"
             x:Class="GigRadarMobile.Views.UsersPage"
             x:DataType="vm:UsersViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Users">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="20,20,20,0" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="ADMIN" Style="{StaticResource Eyebrow}"/>
            <Label Text="Semua pengguna" Style="{StaticResource PageTitle}"/>
        </VerticalStackLayout>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>
        <Label Grid.Row="2" Text="{Binding StatusMessage}" Style="{StaticResource Body}" TextColor="{StaticResource DangerColor}"
               IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
               HorizontalTextAlignment="Center"/>

        <!-- Permohonan role menunggu verifikasi (§25) -->
        <VerticalStackLayout Grid.Row="3" Spacing="8" IsVisible="{Binding HasRoleRequests}">
            <Label Text="PERMINTAAN PERAN MENUNGGU VERIFIKASI" Style="{StaticResource Eyebrow}" TextColor="{StaticResource WarningColor}"/>
            <CollectionView ItemsSource="{Binding RoleRequests}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:RoleRequestItem">
                        <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding UserName}" Style="{StaticResource Subheading}" FontSize="15"/>
                                    <Label Text="{Binding UserEmail}" Style="{StaticResource Caption}" FontSize="12"/>
                                    <Label Text="{Binding RequestedRoleDisplay}" Style="{StaticResource Meta}" TextColor="{StaticResource WarningColor}"/>
                                </VerticalStackLayout>                                <Button Grid.Column="1" Text="Tolak" Style="{StaticResource Chip}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsersViewModel}}, Path=RejectCommand}" CommandParameter="{Binding .}"/>
                                <Button Grid.Column="2" Text="Setujui" Style="{StaticResource Chip}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsersViewModel}}, Path=ApproveCommand}" CommandParameter="{Binding .}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- Daftar seluruh user -->
        <CollectionView Grid.Row="4" ItemsSource="{Binding Users}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:User">
                    <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource CardElevatedColor}">
                                <Label Text="{Binding Initials}" FontFamily="SpaceGroteskBold" FontSize="14"
                                       TextColor="{StaticResource PrimaryColor}" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}" Style="{StaticResource Subheading}" FontSize="15"
                                       MaxLines="1" LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding Email}" Style="{StaticResource Caption}" FontSize="12"
                                       MaxLines="1" LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding City}" Style="{StaticResource Meta}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding RoleDisplay}" Style="{StaticResource Meta}" FontSize="11"
                                   FontFamily="InterSemiBold" TextColor="{Binding RoleColor}"
                                   VerticalOptions="Center" HorizontalTextAlignment="End"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>