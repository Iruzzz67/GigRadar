<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             x:Class="GigRadarMobile.Views.TicketSuccessPage"
             x:DataType="vm:TicketSuccessViewModel"
             BackgroundColor="#121212"
             Title="Tiket Berhasil"
             Shell.NavBarIsVisible="True">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="&#x2705; PEMBELIAN BERHASIL" FontSize="18" FontAttributes="Bold" TextColor="#39FF14" HorizontalTextAlignment="Center"/>
            <Label Text="Simpan atau tunjukkan barcode ini saat masuk venue." FontSize="13" TextColor="#B0B0B0" HorizontalTextAlignment="Center"/>

            <!-- Tiket -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="16" Padding="0" BorderColor="#333333" HasShadow="True">
                <VerticalStackLayout>

                    <!-- Header tiket -->
                    <Grid Padding="20,18" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="&#x1F3AB; GIGRADAR TICKET" FontSize="12" FontAttributes="Bold" TextColor="#7B2FFF"/>
                            <Label Text="{Binding EventName}" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding PriceFormatted}" FontSize="16" FontAttributes="Bold" TextColor="#39FF14" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#333333"/>

                    <VerticalStackLayout Padding="20,12" Spacing="6">
                        <Label Text="{Binding EventDate, StringFormat='&#x1F4C5; {0}'}" FontSize="14" TextColor="White"/>
                        <Label Text="{Binding VenueName, StringFormat='&#x1F3EA; {0}'}" FontSize="14" TextColor="#B0B0B0"/>
                        <Label Text="{Binding TypeName, StringFormat='Tipe: {0}'}" FontSize="13" TextColor="#B0B0B0"/>
                        <Label Text="{Binding BuyerName, StringFormat='Atas nama: {0}'}" FontSize="13" TextColor="#B0B0B0"/>
                    </VerticalStackLayout>

                    <!-- Barcode -->
                    <VerticalStackLayout Padding="20,16" Spacing="10" BackgroundColor="White">
                        <GraphicsView x:Name="BarcodeView" HeightRequest="90" WidthRequest="280"
                                      HorizontalOptions="Center"/>
                        <Label Text="{Binding QRCode}" FontSize="11" TextColor="#333333"
                               FontFamily="CourierNew" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <Button Text="&#x1F3AB; Lihat My Tickets" BackgroundColor="#39FF14" TextColor="Black" FontAttributes="Bold"
                    CornerRadius="10" HeightRequest="52"
                    Command="{Binding GoToMyTicketsCommand}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>