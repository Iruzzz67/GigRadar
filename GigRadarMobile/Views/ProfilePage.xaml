<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             x:Class="GigRadarMobile.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             BackgroundColor="#121212"
             Title="Profile">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Frame BackgroundColor="#2A2A2A" CornerRadius="50" WidthRequest="100" HeightRequest="100" HorizontalOptions="Center" Padding="0" HasShadow="False">
                <Label Text="🎸" FontSize="48" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Frame>

            <Label Text="{Binding UserName}" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
            <Label Text="{Binding UserEmail}" FontSize="14" TextColor="#B0B0B0" HorizontalOptions="Center"/>

            <BoxView HeightRequest="1" Color="#333333" Margin="0,8"/>

            <!-- Edit Form -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="10" Padding="16" HasShadow="False" IsVisible="{Binding IsEditing}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Edit Profil" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                    <Entry Text="{Binding UserName}" Placeholder="Nama" BackgroundColor="#2A2A2A" TextColor="White"/>
                    <Entry Text="{Binding UserCity}" Placeholder="Kota" BackgroundColor="#2A2A2A" TextColor="White"/>
                    <Button Text="Simpan" BackgroundColor="#39FF14" TextColor="Black" FontAttributes="Bold" CornerRadius="10" HeightRequest="50" Command="{Binding SaveProfileCommand}"/>
                </VerticalStackLayout>
            </Frame>

            <Button Text="Edit Profil" BackgroundColor="#7B2FFF" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="50" Clicked="OnEditClicked"/>

            <Button Text="📊 Profil Event Organizer" BackgroundColor="#7B2FFF" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="50" IsVisible="{Binding IsStaff}" Command="{Binding GoToEoProfileCommand}"/>

            <Button Text="🎟️ Kelola Tiket Event" BackgroundColor="#39FF14" TextColor="Black" FontAttributes="Bold" CornerRadius="10" HeightRequest="50" IsVisible="{Binding IsStaff}" Command="{Binding GoToManageTicketsCommand}"/>

            <Button Text="Logout" BackgroundColor="#333333" TextColor="#FF4444" CornerRadius="10" HeightRequest="50" Command="{Binding LogoutCommand}"/>

            <Frame BackgroundColor="#1E1E1E" CornerRadius="10" Padding="14" HasShadow="False" Margin="0,20,0,0">
                <VerticalStackLayout Spacing="6">
                    <Label Text="GigRadar v1.0" FontSize="16" FontAttributes="Bold" TextColor="#39FF14"/>
                    <Label Text="Menghubungkan skena, menemukan suara lokal." FontSize="13" TextColor="#B0B0B0"/>
                    <Label Text="Backend: ASP.NET Core + SQLite" FontSize="11" TextColor="#666666"/>
                    <Label Text="Frontend: .NET MAUI" FontSize="11" TextColor="#666666"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
