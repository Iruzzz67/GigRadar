<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             xmlns:behaviors="clr-namespace:GigRadarMobile.Behaviors"
             x:Class="GigRadarMobile.Views.ArtistDetailPage"
             x:DataType="vm:ArtistDetailViewModel"
             Shell.NavBarIsVisible="False"
             Title="Artist">

    <ScrollView>
        <ScrollView.Behaviors>
            <behaviors:ParallaxBehavior Target="{x:Reference ArtistHeroArt}" Factor="0.35"/>
        </ScrollView.Behaviors>
        <VerticalStackLayout Spacing="0">

            <!-- ===== Cover hero ===== -->
            <Grid HeightRequest="400">
                <Image x:Name="ArtistHeroArt"
                       Source="{Binding HeroImageUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter={Binding Artist.Name}}"
                       Aspect="AspectFill"/>
                <BoxView Background="{StaticResource PosterScrim}"/>
                <BoxView HeightRequest="5" VerticalOptions="End"
                         Color="{Binding Artist.Genre, Converter={StaticResource GenreAccentConverter}, ConverterParameter=accent}"/>

                <!-- Avatar artist di atas cover -->
                <Border WidthRequest="84" HeightRequest="84" StrokeThickness="2" Stroke="{StaticResource BorderStrong}"
                        StrokeShape="RoundRectangle 999" Padding="0" Margin="20,0,0,18"
                        HorizontalOptions="Start" VerticalOptions="End">
                    <Grid>
                        <Image Source="{Binding HeroImageUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter={Binding Artist.Name}}"
                               Aspect="AspectFill"/>
                        <BoxView Color="#660B0A0E"/>
                        <Label Text="{Binding Artist.Initials}" FontFamily="SpaceGroteskBold" FontSize="24"
                               TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <Button Text="‹" FontSize="24" Padding="0" WidthRequest="44" HeightRequest="44"
                        Margin="16,12" HorizontalOptions="Start" VerticalOptions="Start"
                        CornerRadius="999" BackgroundColor="#CC1A1A1F" TextColor="{StaticResource TextPrimary}"
                        Command="{Binding GoBackCommand}"/>

                <VerticalStackLayout Padding="20,0,20,18" Spacing="10" VerticalOptions="End">
                    <HorizontalStackLayout Spacing="8">
                        <Border Style="{StaticResource Pill}"
                                IsVisible="{Binding Artist.Genre, Converter={StaticResource StringNotEmptyConverter}}">
                            <Label Text="{Binding Artist.Genre}" Style="{StaticResource PillText}"/>
                        </Border>
                        <Border Style="{StaticResource Pill}"
                                IsVisible="{Binding Artist.City, Converter={StaticResource StringNotEmptyConverter}}">
                            <Label Text="{Binding Artist.City}" Style="{StaticResource PillText}"/>
                        </Border>
                    </HorizontalStackLayout>

                    <Label Text="{Binding Artist.Name}" Style="{StaticResource Display}" FontSize="32"
                           MaxLines="2" LineBreakMode="TailTruncation"/>

                    <Label Text="{Binding FollowersLabel}" Style="{StaticResource Caption}"
                           TextColor="{StaticResource PrimaryColor}"/>
                </VerticalStackLayout>
            </Grid>

            <!-- ===== Konten ===== -->
            <VerticalStackLayout Padding="20,24,20,28" Spacing="28">
                <VerticalStackLayout.Behaviors>
                    <behaviors:EntranceAnimationBehavior FromOffset="20" Duration="380" AnimateScale="False"/>
                </VerticalStackLayout.Behaviors>

                <!-- Statistik -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Style="{StaticResource StatTile}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Artist.FollowersCount}" Style="{StaticResource StatValue}"
                                   TextColor="{StaticResource PrimaryColor}" HorizontalTextAlignment="Center"/>
                            <Label Text="PENGIKUT" Style="{StaticResource StatLabel}" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource StatTile}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Artist.Tracks.Count}" Style="{StaticResource StatValue}" HorizontalTextAlignment="Center"/>
                            <Label Text="TRACK" Style="{StaticResource StatLabel}" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StatTile}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Artist.Albums.Count}" Style="{StaticResource StatValue}" HorizontalTextAlignment="Center"/>
                            <Label Text="ALBUM" Style="{StaticResource StatLabel}" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Bio -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding Artist.Bio, Converter={StaticResource StringNotEmptyConverter}}">
                    <HorizontalStackLayout Spacing="10">
                        <BoxView Style="{StaticResource SectionBar}"/>
                        <Label Text="Tentang" Style="{StaticResource SectionTitleStrong}"/>
                    </HorizontalStackLayout>
                    <Label Text="{Binding Artist.Bio}" Style="{StaticResource Body}" LineHeight="1.35"/>
                </VerticalStackLayout>

                <!-- Upcoming gigs -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasUpcomingGigs}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <HorizontalStackLayout Grid.Column="0" Spacing="10">
                            <BoxView Style="{StaticResource SectionBar}"/>
                            <Label Text="Gig mendatang" Style="{StaticResource SectionTitleStrong}"/>
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="{Binding UpcomingGigs.Count, StringFormat='{0} gig'}"
                               Style="{StaticResource Meta}" VerticalOptions="Center"/>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding UpcomingGigs}" Spacing="2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ArtistGig">
                                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArtistDetailViewModel}}, Path=GoToGigCommand, x:DataType={x:Type vm:ArtistDetailViewModel}}" CommandParameter="{Binding .}"/>
                                    </Grid.GestureRecognizers>
                                    <Grid Grid.Column="0" WidthRequest="46" HeightRequest="46">
                                        <Image Source="{Binding PosterUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter={Binding Name}}"
                                               Aspect="AspectFill"/>
                                        <BoxView Background="{StaticResource PosterScrimSoft}" />
                                        <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                            <Label Text="{Binding StartDate, StringFormat='{0:dd}'}" Style="{StaticResource Numeric}" FontSize="18" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding StartDate, StringFormat='{0:MMM}'}" FontSize="8" FontAttributes="Bold" CharacterSpacing="1"
                                                   TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" Style="{StaticResource Subheading}" MaxLines="2" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding LocationLabel}" Style="{StaticResource Caption}" MaxLines="1" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding StartDate, StringFormat='{0:HH:mm}'}" Style="{StaticResource Meta}"/>
                                    </VerticalStackLayout>
                                    <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                        <Label Text="{Binding PriceLabel}" Style="{StaticResource Numeric}" FontSize="13"
                                               TextColor="{StaticResource PrimaryColor}" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                                        <Label Text="›" FontSize="20" TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Tracks -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <HorizontalStackLayout Grid.Column="0" Spacing="10">
                            <BoxView Style="{StaticResource SectionBar}"/>
                            <Label Text="Musik" Style="{StaticResource SectionTitleStrong}"/>
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="{Binding PlaybackStatus}" Style="{StaticResource Meta}"
                               TextColor="{StaticResource PrimaryColor}" VerticalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation"/>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Artist.Tracks}" Spacing="2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:AudioTrack">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,7">
                                    <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeThickness="1"
                                            Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 10" Padding="0">
                                        <Grid>
                                            <Image Source="{Binding CoverUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter={Binding Title}}"
                                                   Aspect="AspectFill"/>
                                            <BoxView Color="#990B0A0E"/>
                                            <Label Text="♪" FontFamily="SpaceGroteskMedium" FontSize="16"
                                                   TextColor="{StaticResource PrimaryColor}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" Style="{StaticResource Subheading}" MaxLines="1" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding DurationLabel}" Style="{StaticResource Meta}"/>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2" Text="▶" FontSize="12" Padding="0" WidthRequest="40" HeightRequest="40"
                                            CornerRadius="999" BackgroundColor="{StaticResource AccentSoft}" TextColor="{StaticResource PrimaryColor}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArtistDetailViewModel}}, Path=PlayTrackCommand, x:DataType={x:Type vm:ArtistDetailViewModel}}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Members -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasMembers}">
                    <HorizontalStackLayout Spacing="10">
                        <BoxView Style="{StaticResource SectionBar}"/>
                        <Label Text="Personel" Style="{StaticResource SectionTitleStrong}"/>
                    </HorizontalStackLayout>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Artist.Members}" Spacing="2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ArtistMember">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,6">
                                    <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource CardElevatedColor}">
                                        <Label Text="•" FontSize="18" TextColor="{StaticResource TextMuted}"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" Style="{StaticResource Subheading}" FontSize="14" MaxLines="1" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Role}" Style="{StaticResource Meta}"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Posts + like & komentar (Bab 10, 32) -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasPosts}">
                    <HorizontalStackLayout Spacing="10">
                        <BoxView Style="{StaticResource SectionBar}"/>
                        <Label Text="Postingan" Style="{StaticResource SectionTitleStrong}"/>
                    </HorizontalStackLayout>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Artist.Posts}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ArtistPost">
                                <Border Style="{StaticResource CardBorder}" Padding="14">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding Title}" Style="{StaticResource Subheading}" FontSize="15"/>
                                                <Label Text="{Binding DateLabel}" Style="{StaticResource Meta}" TextColor="{StaticResource TextMuted}"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Label Text="{Binding Content}" Style="{StaticResource Body}" FontSize="13"/>

                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="14">
                                            <Button Grid.Column="0" Text="{Binding LikesCount, StringFormat='♥ {0}'}"
                                                    FontSize="12" HeightRequest="34" Padding="12,0" CornerRadius="9"
                                                    BackgroundColor="{StaticResource CardElevatedColor}" TextColor="{StaticResource TextPrimary}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArtistDetailViewModel}}, Path=ToggleLikeCommand, x:DataType={x:Type vm:ArtistDetailViewModel}}"
                                                    CommandParameter="{Binding .}"/>
                                            <Button Grid.Column="1" Text="{Binding CommentsCount, StringFormat='💬 {0}'}"
                                                    FontSize="12" HeightRequest="34" Padding="12,0" CornerRadius="9"
                                                    BackgroundColor="{StaticResource CardElevatedColor}" TextColor="{StaticResource TextPrimary}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArtistDetailViewModel}}, Path=ToggleCommentsCommand, x:DataType={x:Type vm:ArtistDetailViewModel}}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Panel komentar (terbuka dari tombol 💬) -->
                <Border IsVisible="{Binding IsCommentsOpen}" Style="{StaticResource CardBorder}" Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="KOMENTAR" Style="{StaticResource Eyebrow}" VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="Tutup" FontSize="11" HeightRequest="32" Padding="10,0"
                                    CornerRadius="9" BackgroundColor="{StaticResource CardElevatedColor}"
                                    TextColor="{StaticResource TextSecondary}"
                                    Command="{Binding ToggleCommentsCommand}"/>
                        </Grid>

                        <VerticalStackLayout Spacing="8" IsVisible="{Binding HasComments}">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Comments}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:PostCommentItem">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Grid.Column="0" WidthRequest="32" HeightRequest="32" StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource AccentSoft}">
                                                <Label Text="{Binding Initials}" FontSize="11" FontAttributes="Bold"
                                                       TextColor="{StaticResource PrimaryColor}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                <Label Text="{Binding UserName}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                                <Label Text="{Binding Content}" Style="{StaticResource Caption}" FontSize="12"/>
                                                <Label Text="{Binding CreatedAtDisplay}" Style="{StaticResource Meta}" FontSize="10"
                                                       TextColor="{StaticResource TextMuted}"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <Label Text="Belum ada komentar. Jadilah yang pertama!" Style="{StaticResource Caption}"
                               TextColor="{StaticResource TextMuted}"
                               IsVisible="{Binding HasComments, Converter={StaticResource InvertedBoolConverter}}"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0" Text="{Binding NewComment}" Placeholder="Tulis komentar..."
                                   ReturnType="Send" ReturnCommand="{Binding SendCommentCommand}"/>
                            <Button Grid.Column="1" Text="Kirim" Style="{StaticResource BtnPrimary}" HeightRequest="42" WidthRequest="80"
                                    Command="{Binding SendCommentCommand}"
                                    IsEnabled="{Binding IsSendingComment, Converter={StaticResource InvertedBoolConverter}}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Social links -->
                <Label Text="{Binding Artist.SocialLinks}" Style="{StaticResource Meta}"
                       MaxLines="1" LineBreakMode="TailTruncation"
                       IsVisible="{Binding Artist.SocialLinks, Converter={StaticResource StringNotEmptyConverter}}"/>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>