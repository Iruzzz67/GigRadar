<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             x:Class="GigRadarMobile.Views.ArtistDashboardPage"
             x:DataType="vm:ArtistDashboardViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Dashboard Artist">

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Padding="20,18,20,28" Spacing="16">

                <!-- Header hero -->
                <Border Style="{StaticResource HeroBanner}" HeightRequest="200">
                    <Grid>
                        <Image Source="art_aurora" Aspect="AspectFill"/>
                        <BoxView Background="{StaticResource PosterScrim}"/>
                        <VerticalStackLayout Padding="18" Spacing="6" VerticalOptions="End">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="ARTIST DASHBOARD" Style="{StaticResource Overline}"
                                           TextColor="{StaticResource PrimaryColor}"/>
                                    <Label Text="{Binding UserName}" Style="{StaticResource HeroTitle}" FontSize="24"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="✓ Terverifikasi" FontSize="11" FontAttributes="Bold"
                                           TextColor="{StaticResource SuccessColor}"
                                           IsVisible="{Binding IsVerifiedBadgeVisible}"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="1" WidthRequest="52" HeightRequest="52" StrokeThickness="2"
                                        Stroke="{StaticResource BorderStrong}" StrokeShape="RoundRectangle 999"
                                        BackgroundColor="#660B0A0E" VerticalOptions="End">
                                    <Label Text="{Binding Initials}" FontFamily="SpaceGroteskBold" FontSize="17"
                                           TextColor="{StaticResource PrimaryColor}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>

                <!-- Error state -->
                <Frame IsVisible="{Binding HasError}" BackgroundColor="{StaticResource DangerSoft}"
                       BorderColor="{StaticResource BorderColor}" CornerRadius="14" Padding="14" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource Body}" TextColor="{StaticResource DangerColor}"/>
                        <Button Text="Coba lagi" Style="{StaticResource BtnOutline}" HeightRequest="42"
                                Command="{Binding LoadCommand}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Hero: profil artist + aksi utama -->
                <Border Style="{StaticResource CardBorder}" Background="{StaticResource SurfaceSheenGradient}"
                        Stroke="{StaticResource BorderStrong}" Padding="18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="PROFIL KAMU" Style="{StaticResource Eyebrow}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding GenreLabel}" Style="{StaticResource Subheading}"/>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="📍" FontSize="12" TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                                    <Label Text="{Binding CityLabel}" Style="{StaticResource Caption}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Border Grid.Column="1" WidthRequest="48" HeightRequest="48" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource CardColor}"
                                    VerticalOptions="Center">
                                <Label Text="{Binding Initials}" FontFamily="SpaceGroteskBold" FontSize="15"
                                       TextColor="{StaticResource PrimaryColor}" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                        <Button Text="Edit profil artist" Style="{StaticResource BtnPrimary}" HeightRequest="44"
                                Command="{Binding ToggleEditCommand}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Kartu verifikasi (Bab 8) — tampil saat belum verified -->
                <Border IsVisible="{Binding HasVerificationCard}" Style="{StaticResource CardBorder}"
                        Stroke="{StaticResource BorderStrong}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0" WidthRequest="10" HeightRequest="10" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999" VerticalOptions="Center"
                                    BackgroundColor="{Binding VerificationColor}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="VERIFIKASI ARTIST" Style="{StaticResource Eyebrow}"/>
                                <Label Text="{Binding VerificationLabel}" Style="{StaticResource Body}" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" Style="{StaticResource PageTitle}" FontSize="18"
                                   TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                        </Grid>
                        <Label Text="Profil terverifikasi memberi kepercayaan lebih ke penonton dan EO."
                               Style="{StaticResource Caption}" TextColor="{StaticResource TextSecondary}"/>
                        <Button Text="Lihat status verifikasi" Style="{StaticResource BtnOutline}" HeightRequest="42"
                                Command="{Binding GoToVerificationCommand}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Statistik karier -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatTile}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding FollowersLabel}" Style="{StaticResource StatValue}"
                                   TextColor="{StaticResource PrimaryColor}"/>
                            <Label Text="PENGIKUT" Style="{StaticResource StatLabel}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatTile}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding TracksLabel}" Style="{StaticResource StatValue}"
                                   TextColor="{StaticResource StageCyan}"/>
                            <Label Text="TRACK" Style="{StaticResource StatLabel}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StatTile}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding AlbumsLabel}" Style="{StaticResource StatValue}"
                                   TextColor="{StaticResource StageAmber}"/>
                            <Label Text="ALBUM" Style="{StaticResource StatLabel}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatTile}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding PostsLabel}" Style="{StaticResource StatValue}"
                                   TextColor="{StaticResource StageViolet}"/>
                            <Label Text="POST" Style="{StaticResource StatLabel}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Gig mendatang -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10">
                        <BoxView Style="{StaticResource SectionBar}"/>
                        <Label Text="Gig mendatang" Style="{StaticResource SectionTitleStrong}"/>
                    </HorizontalStackLayout>
                    <Label Grid.Column="1" Text="{Binding GigsCountLabel}" Style="{StaticResource Meta}"
                           VerticalOptions="Center"/>
                </Grid>

                <Label Text="Belum ada gig mendatang. Event yang menampilkan kamu di line-up akan muncul di sini."
                       IsVisible="{Binding HasGigs, Converter={StaticResource InvertedBoolConverter}}"
                       Style="{StaticResource Body}"/>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding UpcomingGigs}" Spacing="2"
                                     IsVisible="{Binding HasGigs}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ArtistGig">
                            <Border Style="{StaticResource CardBorder}" Padding="10" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArtistDashboardViewModel}}, Path=GoToGigCommand, x:DataType={x:Type vm:ArtistDashboardViewModel}}"
                                                          CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                                <Grid Grid.Column="0" WidthRequest="52" HeightRequest="52">
                                    <Image Source="{Binding PosterUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter={Binding Name}}"
                                           Aspect="AspectFill"/>
                                    <BoxView Background="{StaticResource PosterScrimSoft}"/>
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                        <Label Text="{Binding StartDate, StringFormat='{0:dd}'}" Style="{StaticResource Numeric}"
                                               FontSize="18" HorizontalTextAlignment="Center"/>
                                        <Label Text="{Binding StartDate, StringFormat='{0:MMM}'}" FontSize="8" FontAttributes="Bold"
                                               CharacterSpacing="1" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" Style="{StaticResource Subheading}" MaxLines="2"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding LocationLabel}" Style="{StaticResource Caption}" MaxLines="1"
                                           LineBreakMode="TailTruncation"/>
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding StartDate, StringFormat='{0:HH:mm}'}" Style="{StaticResource Meta}"/>
                                        <Label Text="{Binding StatusLabel}" Style="{StaticResource Meta}"
                                               TextColor="{Binding StatusColor}"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                    <Label Text="{Binding PriceLabel}" Style="{StaticResource Numeric}" FontSize="13"
                                           TextColor="{StaticResource PrimaryColor}" VerticalOptions="Center"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="›" FontSize="20" TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Form edit profil artist -->
                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsEditing}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Edit profil artist" Style="{StaticResource Subheading}"/>
                        <Entry Text="{Binding FormName}" Placeholder="Nama artist"/>
                        <Entry Text="{Binding FormGenre}" Placeholder="Genre (mis. Indie Rock)"/>
                        <Entry Text="{Binding FormCity}" Placeholder="Kota domisili"/>
                        <Editor Text="{Binding FormBio}" Placeholder="Bio singkat band/kamu"
                                AutoSize="TextChanges"/>
                        <Entry Text="{Binding FormPhotoUrl}" Placeholder="URL foto profil (opsional)"
                                Keyboard="Url"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Batal" Style="{StaticResource BtnDark}" HeightRequest="44"
                                    Command="{Binding ToggleEditCommand}"/>
                            <Button Grid.Column="1" Text="Simpan" Style="{StaticResource BtnPrimary}" HeightRequest="44"
                                    Command="{Binding SaveProfileCommand}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>