<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:GigRadarMobile.Views"
       x:Class="GigRadarMobile.Shells.UserShell"
       Shell.FlyoutBehavior="Disabled"
       Title="GigRadar">

    <!-- GIGRADAR_ROLE_SYSTEM.md §26 — UserShell -->
    <TabBar>
        <ShellContent Title="Discover" ContentTemplate="{DataTemplate views:HomePage}" Route="home"/>
        <ShellContent Title="Explore" ContentTemplate="{DataTemplate views:ExplorePage}" Route="explore"/>
        <ShellContent Title="Radar" ContentTemplate="{DataTemplate views:RadarPage}" Route="radar"/>
        <ShellContent Title="Tickets" ContentTemplate="{DataTemplate views:TicketPage}" Route="tickets"/>
        <ShellContent Title="Profile" ContentTemplate="{DataTemplate views:ProfilePage}" Route="profile"/>
    </TabBar>

</Shell>