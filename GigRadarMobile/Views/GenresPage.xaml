<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             x:Class="GigRadarMobile.Views.GenresPage"
             x:DataType="vm:AdminGenresViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Kelola Genre">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="20,18,20,16" RowSpacing="12">

        <Border Grid.Row="0" Style="{StaticResource PageHero}" HeightRequest="140">
            <Grid>
                <Image Source="art_haze" Aspect="AspectFill"/>
                <BoxView Background="{StaticResource PosterScrim}"/>
                <BoxView WidthRequest="5" HorizontalOptions="Start" Background="{StaticResource AuroraGradient}"/>
                <Grid Padding="16" ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="End">
                    <VerticalStackLayout Spacing="4" VerticalOptions="End">
                        <Label Text="ADMIN" Style="{StaticResource Overline}" TextColor="{StaticResource StageViolet}"/>
                        <Label Text="Data master genre" Style="{StaticResource HeroTitle}" FontSize="22"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Tambah" Style="{StaticResource BtnPrimary}" HeightRequest="40"
                            Command="{Binding ShowCreateFormCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <Label Grid.Row="1" Text="{Binding StatusMessage}" Style="{StaticResource Body}" FontSize="12"
               TextColor="{StaticResource PrimaryColor}"
               IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"/>

        <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>

        <!-- Form tambah/ubah genre -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" IsVisible="{Binding IsFormVisible}">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding FormTitle}" Style="{StaticResource Subheading}"
                       TextColor="{StaticResource PrimaryColor}"/>
                <Entry Text="{Binding FormName}" Placeholder="Nama genre (mis. Shoegaze)"/>
                <Entry Text="{Binding FormIcon}" Placeholder="Ikon (opsional, mis. 🌙)"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Batal" Style="{StaticResource BtnOutline}" HeightRequest="46"
                            Command="{Binding CancelFormCommand}"/>
                    <Button Grid.Column="1" Text="Simpan" Style="{StaticResource BtnPrimary}" HeightRequest="46"
                            Command="{Binding SaveGenreCommand}"/>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <RefreshView Grid.Row="4" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Spacing="8">

                    <Frame IsVisible="{Binding HasError}" BackgroundColor="{StaticResource CardColor}"
                           BorderColor="{StaticResource BorderColor}" CornerRadius="14" Padding="16" HasShadow="False">
                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource Body}" FontSize="13"
                               TextColor="{StaticResource DangerColor}"/>
                    </Frame>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Genres}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Genre">
                                <Border Style="{StaticResource CardBorder}" Padding="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{Binding Icon}" FontSize="18"
                                               VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Subheading}"
                                               FontSize="15" VerticalOptions="Center"
                                               MaxLines="1" LineBreakMode="TailTruncation"/>
                                        <Button Grid.Column="2" Text="Ubah" Style="{StaticResource Chip}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminGenresViewModel}}, Path=EditGenreCommand, x:DataType={x:Type vm:AdminGenresViewModel}}"
                                                CommandParameter="{Binding .}"/>
                                        <Button Grid.Column="3" Text="Hapus" FontSize="11" HeightRequest="34" Padding="10,0"
                                                CornerRadius="9" BackgroundColor="{StaticResource AccentSoft}"
                                                TextColor="{StaticResource DangerColor}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminGenresViewModel}}, Path=DeleteGenreCommand, x:DataType={x:Type vm:AdminGenresViewModel}}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>

</ContentPage>
