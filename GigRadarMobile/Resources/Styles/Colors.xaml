<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
      GIGRADAR palette — "signal lime" on zinc.
      Aksen dipakai strategis: CTA utama, angka kunci, radar, status aktif.
      Hierarki dibuat lewat permukaan + border, bukan shadow/neon.
    -->

    <!-- Surfaces -->
    <Color x:Key="BackgroundColor">#0B0A0E</Color>
    <Color x:Key="SurfaceColor">#141218</Color>
    <Color x:Key="CardColor">#1A1720</Color>
    <Color x:Key="CardElevatedColor">#24202B</Color>
    <Color x:Key="BorderColor">#2C2733</Color>
    <Color x:Key="BorderStrong">#494052</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#F4F4F5</Color>
    <Color x:Key="TextSecondary">#A1A1AA</Color>
    <!-- #8B8B93 ≈ 5.0:1 di BackgroundColor (sebelumnya #71717A ≈ 4.3:1 — di bawah WCAG 4.5:1) -->
    <Color x:Key="TextMuted">#8B8B93</Color>
    <Color x:Key="OnDark">#F4F4F5</Color>

    <!-- Accent (radar signal lime) -->
    <Color x:Key="PrimaryColor">#A3FF12</Color>
    <Color x:Key="AccentColor">#A3FF12</Color>
    <Color x:Key="AccentSoft">#1B260D</Color>
    <Color x:Key="OnAccent">#0A0A0B</Color>

    <!-- Aksen sekunder (cyan) — untuk filter/aksi pendukung agar tidak
         semua kontrol memakai lime yang sama. -->
    <Color x:Key="SecondaryColor">#22D3EE</Color>
    <Color x:Key="SecondarySoft">#0E2830</Color>

    <!--
      Stage accents ("neon night stage") — keluarga warna panggung.
      Dipakai bergantian per genre/role agar tiap section punya identitas,
      tanpa mengorbankan hierarki: tetap aksen, bukan latar dominan.
    -->
    <Color x:Key="StagePink">#FF4D8D</Color>
    <Color x:Key="StageAmber">#F6C453</Color>
    <Color x:Key="StageViolet">#8B5CF6</Color>
    <Color x:Key="StageCyan">#22D3EE</Color>
    <Color x:Key="StageEmber">#FB7185</Color>
    <Color x:Key="StageSoft">#2C1725</Color>

    <!-- Tint gelap satu tingkat dari tiap accent — untuk chip/badge/ikon lembut. -->
    <Color x:Key="PinkSoft">#2E1424</Color>
    <Color x:Key="AmberSoft">#2B2110</Color>
    <Color x:Key="VioletSoft">#1E1735</Color>
    <Color x:Key="CyanSoft">#0E2830</Color>

    <!-- ============================================================
         Gradient brushes — dipakai untuk hero, poster scrim, dan tile.
         Sengaja sedikit supaya tidak jadi pelangi; tiap section pilih satu.
         ============================================================ -->

    <!-- Hero lime→violet: identitas utama GigRadar (discovery, CTA besar). -->
    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A3FF12" Offset="0.0"/>
        <GradientStop Color="#7DE2B0" Offset="0.45"/>
        <GradientStop Color="#8B5CF6" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Aurora violet→cyan: area artist/kreatif. -->
    <LinearGradientBrush x:Key="AuroraGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0.0"/>
        <GradientStop Color="#22D3EE" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Ember pink→amber: event/tiket (energi panggung). -->
    <LinearGradientBrush x:Key="EmberGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4D8D" Offset="0.0"/>
        <GradientStop Color="#F6C453" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Stage lime→cyan: radar/signal. -->
    <LinearGradientBrush x:Key="SignalGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A3FF12" Offset="0.0"/>
        <GradientStop Color="#22D3EE" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Chip lunak untuk latar ikon/avatar (bukan teks). -->
    <LinearGradientBrush x:Key="SurfaceSheenGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#241F2E" Offset="0.0"/>
        <GradientStop Color="#191622" Offset="1.0"/>
    </LinearGradientBrush>

    <!--
      Scrim poster: dipasang di atas artwork/foto supaya judul & meta tetap
      terbaca (WCAG) apapun gambarnya. Beberapa tingkat kekuatan.
    -->
    <LinearGradientBrush x:Key="PosterScrim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0.0"/>
        <GradientStop Color="#99000000" Offset="0.55"/>
        <GradientStop Color="#F20B0A0E" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PosterScrimSoft" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0.0"/>
        <GradientStop Color="#73000000" Offset="0.6"/>
        <GradientStop Color="#D90B0A0E" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PosterScrimTop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B3000000" Offset="0.0"/>
        <GradientStop Color="#00000000" Offset="0.5"/>
    </LinearGradientBrush>

    <!-- Semantic -->
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#F43F5E</Color>
    <Color x:Key="DangerSoft">#2A1219</Color> <!-- latar tint aksi destruktif (padanan AccentSoft untuk danger) -->

    <!-- Neutral scale (utilitas) -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

</ResourceDictionary>