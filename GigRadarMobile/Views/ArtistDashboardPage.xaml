<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             x:Class="GigRadarMobile.Views.ArtistDashboardPage"
             x:DataType="vm:ArtistDashboardViewModel"
             BackgroundColor="#121212"
             Title="Artist Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Frame BackgroundColor="#2A2A2A" CornerRadius="50" WidthRequest="90" HeightRequest="90"
                   HorizontalOptions="Center" Padding="0" HasShadow="False">
                <Label Text="&#x1F3B8;" FontSize="44" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Frame>

            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding UserName}" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                <Label Text="{Binding UserRole}" FontSize="12" FontAttributes="Bold" TextColor="#FFB020" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#333333" Margin="0,4"/>

            <Frame BackgroundColor="#1E1E1E" CornerRadius="12" Padding="16" BorderColor="#333333" HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🚧 Dashboard Artist" FontSize="17" FontAttributes="Bold" TextColor="#FFB020"/>
                    <Label Text="Halaman ini masih placeholder. Sesuai GIGRADAR_ROLE_SYSTEM.md, fitur Artist akan mencakup:"
                           FontSize="13" TextColor="#B0B0B0"/>
                    <Label Text="• Musik (track &amp; album)&#10;• Post &amp; update&#10;• Gigs (jadwal tampil)&#10;• Journey (perkembangan artist)&#10;• Follower &amp; audience"
                           FontSize="13" TextColor="White" LineHeight="1.4"/>
                    <Label Text="Fitur-fitur ini masuk Phase 3 (Artist Experience) dan sedang menunggu pengembangan berikutnya."
                           FontSize="12" TextColor="#666666"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>