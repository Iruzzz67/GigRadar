<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
		  Satu project .NET MAUI multi-platform:
		  - Android, iOS, Mac Catalyst selalu aktif
		  - Windows hanya ditambahkan saat build di OS Windows (sesuai template MAUI resmi)
		-->
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>GigRadarMobile</RootNamespace>
		<AssemblyName>GigRadarMobile</AssemblyName>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>GigRadar</ApplicationTitle>

		<!-- App Identifier (Android package / iOS bundle id) -->
		<ApplicationId>com.gigradar.app</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Windows unpackaged: memudahkan build & run development tanpa MSIX -->
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>

		<!--
		  Android Release: hasilkan APK (bukan .aab) agar mudah di-install langsung.
		  Trimming dinonaktifkan: ApiService memakai System.Text.Json berbasis reflection,
		  dan stabilitas runtime diprioritaskan di atas ukuran APK.
		-->
		<AndroidPackageFormat Condition="'$(TargetFramework)' == 'net10.0-android' AND '$(Configuration)' == 'Release'">apk</AndroidPackageFormat>
		<PublishTrimmed Condition="'$(TargetFramework)' == 'net10.0-android' AND '$(Configuration)' == 'Release'">false</PublishTrimmed>
		<RunAOTCompilation Condition="'$(TargetFramework)' == 'net10.0-android' AND '$(Configuration)' == 'Release'">false</RunAOTCompilation>

		<!--
		  Signing Release via environment variables (JANGAN hardcode password di sini):
		    GIGRADAR_KEYSTORE_PATH      - path ke file .keystore/.jks
		    GIGRADAR_KEYSTORE_PASSWORD  - password keystore
		    GIGRADAR_KEY_ALIAS          - alias key
		    GIGRADAR_KEY_PASSWORD       - password key (boleh sama dengan store)
		  Jika variabel tidak diset, APK Release dihasilkan TANPA signing release
		  (tidak dapat dipasang) — set variabel atau pakai scripts/build-android-release.ps1.
		  Cara membuat keystore: lihat docs/ANDROID_PRODUCTION.md §2.
		-->
		<AndroidKeyStore Condition="'$(TargetFramework)' == 'net10.0-android' AND '$(Configuration)' == 'Release' AND '$(GIGRADAR_KEYSTORE_PATH)' != ''">True</AndroidKeyStore>
		<!-- v1 wajib utk minSdk 23 (Android 6); v2 utk Android 7+. -->
		<AndroidSigningSchemeV1 Condition="'$(TargetFramework)' == 'net10.0-android' AND '$(Configuration)' == 'Release'">true</AndroidSigningSchemeV1>
		<AndroidSigningSchemeV2 Condition="'$(TargetFramework)' == 'net10.0-android' AND '$(Configuration)' == 'Release'">true</AndroidSigningSchemeV2>
		<AndroidSigningKeyStore Condition="'$(TargetFramework)' == 'net10.0-android' AND '$(Configuration)' == 'Release' AND '$(GIGRADAR_KEYSTORE_PATH)' != ''">$(GIGRADAR_KEYSTORE_PATH)</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias Condition="'$(TargetFramework)' == 'net10.0-android' AND '$(Configuration)' == 'Release' AND '$(GIGRADAR_KEY_ALIAS)' != ''">$(GIGRADAR_KEY_ALIAS)</AndroidSigningKeyAlias>
		<AndroidSigningStorePass Condition="'$(TargetFramework)' == 'net10.0-android' AND '$(Configuration)' == 'Release' AND '$(GIGRADAR_KEYSTORE_PASSWORD)' != ''">$(GIGRADAR_KEYSTORE_PASSWORD)</AndroidSigningStorePass>
		<AndroidSigningKeyPass Condition="'$(TargetFramework)' == 'net10.0-android' AND '$(Configuration)' == 'Release' AND '$(GIGRADAR_KEY_PASSWORD)' != ''">$(GIGRADAR_KEY_PASSWORD)</AndroidSigningKeyPass>

		<!--
		  Cleartext HTTP: hanya diizinkan pada Debug (API lokal via adb reverse / localhost).
		  Release wajib HTTPS — nilai placeholder disetel dari konfigurasi build.
		-->
		<AndroidManifestPlaceholders Condition="'$(TargetFramework)' == 'net10.0-android' AND '$(Configuration)' == 'Debug'">gigradarCleartext=true</AndroidManifestPlaceholders>
		<AndroidManifestPlaceholders Condition="'$(TargetFramework)' == 'net10.0-android' AND '$(Configuration)' != 'Debug'">gigradarCleartext=false</AndroidManifestPlaceholders>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0A0A0B" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0A0A0B" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

</Project>
