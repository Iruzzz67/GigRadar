<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- gigradarCleartext disetel dari csproj: true hanya untuk Debug (API lokal
	     via adb reverse/localhost). Release = false, wajib HTTPS. -->
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:usesCleartextTraffic="${gigradarCleartext}" />
	<!-- Peta memakai tile CARTO via WebView (tidak butuh Google Maps API key).
	     Kalau kelak butuh Maps SDK native, key WAJIB disimpan sebagai secret
	     (dotnet user-secrets / CI variable), bukan di-commit ke manifest. -->
	<!-- INTERNET + NETWORK_STATE: komunikasi API (wajib). -->
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>