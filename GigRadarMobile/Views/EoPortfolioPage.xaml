<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             x:Class="GigRadarMobile.Views.EoPortfolioPage"
             x:DataType="vm:EoPortfolioViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Portfolio EO">

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
        <ScrollView>
            <VerticalStackLayout Padding="20,18,20,28" Spacing="16">

                <!-- Header -->
                <Border Style="{StaticResource PageHero}" HeightRequest="150">
                    <Grid>
                        <Image Source="art_grid" Aspect="AspectFill"/>
                        <BoxView Background="{StaticResource PosterScrim}"/>
                        <BoxView WidthRequest="5" HorizontalOptions="Start" Background="{StaticResource AuroraGradient}"/>
                        <VerticalStackLayout Padding="16" Spacing="4" VerticalOptions="End">
                            <Label Text="EVENT ORGANIZER" Style="{StaticResource Overline}" TextColor="{StaticResource StageCyan}"/>
                            <Label Text="Portfolio &amp; Profil" Style="{StaticResource HeroTitle}" FontSize="24"/>
                            <Label Text="Portofolio event sebelumnya adalah bukti pengalaman untuk verifikasi EO."
                                   Style="{StaticResource Body}" FontSize="12"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>
                <Label Text="{Binding StatusMessage}" Style="{StaticResource Body}" TextColor="{StaticResource DangerColor}"
                       IsVisible="{Binding HasStatusMessage}"/>

                <!-- Profil organizer -->
                <Frame BackgroundColor="{StaticResource CardColor}" BorderColor="{StaticResource BorderColor}"
                       CornerRadius="14" Padding="16" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="PROFIL ORGANISASI" Style="{StaticResource Eyebrow}" VerticalOptions="Center"/>
                            <Border Grid.Column="1" IsVisible="{Binding IsVerifiedBadgeVisible}"
                                    BackgroundColor="{StaticResource AccentSoft}" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999" Padding="10,4">
                                <Label Text="✓ Terverifikasi" FontSize="12" FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryColor}"/>
                            </Border>
                        </Grid>

                        <Label Text="{Binding Profile.OrganizationName}" Style="{StaticResource Subheading}"/>
                        <Label Text="{Binding Profile.Description}" Style="{StaticResource Caption}"
                               TextColor="{StaticResource TextSecondary}"
                               IsVisible="{Binding Profile.Description, Converter={StaticResource StringNotEmptyConverter}}"/>
                        <Label Text="{Binding Profile.Location, StringFormat='📍 {0}'}" Style="{StaticResource Caption}"
                               TextColor="{StaticResource TextSecondary}"
                               IsVisible="{Binding Profile.Location, Converter={StaticResource StringNotEmptyConverter}}"/>
                        <Label Text="{Binding Profile.WebsiteUrl}" Style="{StaticResource Caption}"
                               TextColor="{StaticResource PrimaryColor}" LineBreakMode="TailTruncation"
                               IsVisible="{Binding Profile.HasWebsite}"/>

                        <Button Text="{Binding ToggleEditLabel}" Style="{StaticResource BtnOutline}" HeightRequest="42"
                                Command="{Binding ToggleEditCommand}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Form edit profil -->
                <Frame IsVisible="{Binding IsEditing}" BackgroundColor="{StaticResource SurfaceColor}"
                       BorderColor="{StaticResource BorderStrong}" CornerRadius="14" Padding="16" HasShadow="False">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="EDIT PROFIL" Style="{StaticResource Eyebrow}"/>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Nama organisasi *" Style="{StaticResource Caption}"/>
                            <Entry Text="{Binding EditOrganizationName}" Placeholder="Mis. Rundown Presents"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Deskripsi" Style="{StaticResource Caption}"/>
                            <Editor Text="{Binding EditDescription}" Placeholder="Ceritakan organisasi kamu."
                                    AutoSize="TextChanges" MinimumHeightRequest="80"/>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="Lokasi" Style="{StaticResource Caption}"/>
                                <Entry Text="{Binding EditLocation}" Placeholder="Jakarta"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Tahun berdiri" Style="{StaticResource Caption}"/>
                                <Entry Text="{Binding EditFoundedYear}" Placeholder="2019" Keyboard="Numeric"/>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Kontak" Style="{StaticResource Caption}"/>
                            <Entry Text="{Binding EditContact}" Placeholder="081234567890" Keyboard="Telephone"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Website" Style="{StaticResource Caption}"/>
                            <Entry Text="{Binding EditWebsiteUrl}" Placeholder="https://..." Keyboard="Url"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Social media" Style="{StaticResource Caption}"/>
                            <Entry Text="{Binding EditSocialLinks}" Placeholder="IG: @organizer · X: @organizer"/>
                        </VerticalStackLayout>

                        <Label Text="{Binding EditError}" Style="{StaticResource Meta}" TextColor="{StaticResource DangerColor}"
                               IsVisible="{Binding EditError, Converter={StaticResource StringNotEmptyConverter}}"/>

                        <Button Text="Simpan profil" Style="{StaticResource BtnPrimary}" HeightRequest="46"
                                Command="{Binding SaveProfileCommand}"
                                IsEnabled="{Binding IsSaving, Converter={StaticResource InvertedBoolConverter}}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Portofolio -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label Text="PORTOFOLIO EVENT" Style="{StaticResource Eyebrow}" VerticalOptions="Center"/>
                    <Button Grid.Column="1" Text="+ Tambah" Style="{StaticResource BtnOutline}" HeightRequest="38"
                            Command="{Binding ToggleAddPortfolioCommand}"/>
                </Grid>

                <!-- Form tambah portofolio -->
                <Frame IsVisible="{Binding IsAddPortfolioVisible}" BackgroundColor="{StaticResource SurfaceColor}"
                       BorderColor="{StaticResource BorderStrong}" CornerRadius="14" Padding="16" HasShadow="False">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="TAMBAH PORTOFOLIO" Style="{StaticResource Eyebrow}"/>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Nama event *" Style="{StaticResource Caption}"/>
                            <Entry Text="{Binding FormEventName}" Placeholder="Mis. Panggung Indie #3"/>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="Tanggal" Style="{StaticResource Caption}"/>
                                <Entry Text="{Binding FormEventDate}" Placeholder="2025-08-17"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Venue" Style="{StaticResource Caption}"/>
                                <Entry Text="{Binding FormVenue}" Placeholder="Bentara Budaya"/>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Deskripsi" Style="{StaticResource Caption}"/>
                            <Editor Text="{Binding FormDescription}" Placeholder="Skala event, jumlah penonton, dsb."
                                    AutoSize="TextChanges" MinimumHeightRequest="70"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Link foto / dokumentasi" Style="{StaticResource Caption}"/>
                            <Entry Text="{Binding FormPhotosUrl}" Placeholder="https://foto... (opsional)" Keyboard="Url"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Link dokumentasi lain" Style="{StaticResource Caption}"/>
                            <Entry Text="{Binding FormDocumentationLink}" Placeholder="https://artikel... (opsional)" Keyboard="Url"/>
                        </VerticalStackLayout>

                        <Label Text="{Binding FormError}" Style="{StaticResource Meta}" TextColor="{StaticResource DangerColor}"
                               IsVisible="{Binding FormError, Converter={StaticResource StringNotEmptyConverter}}"/>

                        <Button Text="Tambah ke portofolio" Style="{StaticResource BtnPrimary}" HeightRequest="46"
                                Command="{Binding AddPortfolioCommand}"
                                IsEnabled="{Binding IsAddingPortfolio, Converter={StaticResource InvertedBoolConverter}}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Daftar portofolio -->
                <Frame IsVisible="{Binding HasPortfolio, Converter={StaticResource InvertedBoolConverter}}"
                       BackgroundColor="{StaticResource CardColor}" BorderColor="{StaticResource BorderColor}"
                       CornerRadius="14" Padding="18" HasShadow="False">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="BELUM ADA PORTFOLIO" Style="{StaticResource Eyebrow}"/>
                        <Label Text="Tambahkan minimal satu event yang pernah kamu gelar — ini syarat verifikasi EO."
                               Style="{StaticResource Body}" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                    </VerticalStackLayout>
                </Frame>

                <CollectionView ItemsSource="{Binding Portfolio}" SelectionMode="None" IsVisible="{Binding HasPortfolio}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PortfolioItem">
                            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,8">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding EventName}" Style="{StaticResource Subheading}" FontSize="15"/>
                                            <Label Text="{Binding EventDateDisplay, StringFormat='📅 {0}'}" Style="{StaticResource Meta}"
                                                   TextColor="{StaticResource TextMuted}"/>
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="Hapus" FontSize="11" HeightRequest="36" Padding="10,0"
                                                BackgroundColor="{StaticResource DangerSoft}" TextColor="{StaticResource DangerColor}"
                                                CornerRadius="9"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EoPortfolioViewModel}}, Path=DeletePortfolioCommand, x:DataType={x:Type vm:EoPortfolioViewModel}}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                    <Label Text="{Binding Venue, StringFormat='📍 {0}'}" Style="{StaticResource Caption}"
                                           FontSize="12" TextColor="{StaticResource TextSecondary}"
                                           IsVisible="{Binding HasVenue}"/>
                                    <Label Text="{Binding Description}" Style="{StaticResource Caption}" FontSize="12"
                                           TextColor="{StaticResource TextSecondary}" MaxLines="3"
                                           IsVisible="{Binding HasDescription}"/>
                                    <Label Text="{Binding DocumentationLink}" Style="{StaticResource Caption}" FontSize="12"
                                           TextColor="{StaticResource PrimaryColor}" LineBreakMode="TailTruncation"
                                           IsVisible="{Binding HasLink}"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
