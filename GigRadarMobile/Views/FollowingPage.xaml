<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             x:Class="GigRadarMobile.Views.FollowingPage"
             x:DataType="vm:FollowingViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Following">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,18,20,16" RowSpacing="12">

        <Border Grid.Row="0" Style="{StaticResource PageHero}" HeightRequest="130">
            <Grid>
                <Image Source="art_grid" Aspect="AspectFill"/>
                <BoxView Background="{StaticResource PosterScrim}"/>
                <BoxView WidthRequest="5" HorizontalOptions="Start" Background="{StaticResource SignalGradient}"/>
                <Grid Padding="16" ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="End">
                    <VerticalStackLayout Spacing="4" VerticalOptions="End">
                        <Label Text="GIGRADAR" Style="{StaticResource Overline}" TextColor="{StaticResource PrimaryColor}"/>
                        <Label Text="Following" Style="{StaticResource HeroTitle}" FontSize="24"/>
                        <Label Text="{Binding CountLabel}" Style="{StaticResource Meta}"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Jelajahi" Style="{StaticResource BtnOutline}" HeightRequest="40"
                            Command="{Binding ExploreArtistsCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>

        <!-- Error state: gagal memuat ≠ tidak mengikuti siapa pun -->
        <Frame Grid.Row="2" IsVisible="{Binding HasError}"
               BackgroundColor="{StaticResource CardColor}" BorderColor="{StaticResource BorderColor}"
               CornerRadius="14" Padding="18" HasShadow="False" VerticalOptions="Start">
            <VerticalStackLayout Spacing="8">
                <Label Text="GAGAL MEMUAT" Style="{StaticResource Eyebrow}"/>
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource Body}" FontSize="13"
                       TextColor="{StaticResource TextSecondary}"/>
                <Button Text="Coba lagi" Style="{StaticResource BtnPrimary}" HeightRequest="42"
                        HorizontalOptions="Start" Command="{Binding LoadCommand}"/>
            </VerticalStackLayout>
        </Frame>

        <!-- Empty state -->
        <Frame Grid.Row="2" IsVisible="{Binding ShowEmptyState}"
               BackgroundColor="{StaticResource CardColor}" BorderColor="{StaticResource BorderColor}"
               CornerRadius="14" Padding="18" HasShadow="False" VerticalOptions="Start">
            <VerticalStackLayout Spacing="8">
                <Label Text="BELUM MENGIKUTI ARTIST" Style="{StaticResource Eyebrow}"/>
                <Label Text="Ikuti artist favoritmu — update, rilis, dan gig mereka akan muncul di sini."
                       Style="{StaticResource Body}" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                <Button Text="Cari artist" Style="{StaticResource BtnPrimary}" HeightRequest="42"
                        HorizontalOptions="Start" Command="{Binding ExploreArtistsCommand}"/>
            </VerticalStackLayout>
        </Frame>

        <RefreshView Grid.Row="2" IsVisible="{Binding HasFollowedArtists}"
                     Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Artists}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:FollowedArtist">
                            <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,2">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FollowingViewModel}}, Path=OpenArtistCommand, x:DataType={x:Type vm:FollowingViewModel}}"
                                            CommandParameter="{Binding .}"/>
                                    </Grid.GestureRecognizers>

                                    <Border Grid.Column="0" WidthRequest="46" HeightRequest="46" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 999" Padding="0"
                                            BackgroundColor="{StaticResource CardElevatedColor}">
                                        <Grid>
                                            <Image Source="{Binding ArtistPhotoUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter={Binding ArtistName}}"
                                                   Aspect="AspectFill"/>
                                            <Label Text="{Binding Initials}" FontFamily="SpaceGroteskBold" FontSize="15"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding ArtistName}" Style="{StaticResource Subheading}" FontSize="15"
                                               MaxLines="1" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding GenreLabel}" Style="{StaticResource Caption}" FontSize="12"
                                               TextColor="{StaticResource TextSecondary}"/>
                                        <Label Text="{Binding FollowedSinceLabel}" Style="{StaticResource Meta}" FontSize="10"
                                               TextColor="{StaticResource TextMuted}"/>
                                    </VerticalStackLayout>

                                    <Button Grid.Column="2" Text="Berhenti" FontSize="11" HeightRequest="34" Padding="12,0"
                                            CornerRadius="9" BackgroundColor="{StaticResource AccentSoft}"
                                            TextColor="{StaticResource PrimaryColor}" VerticalOptions="Center"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FollowingViewModel}}, Path=UnfollowCommand, x:DataType={x:Type vm:FollowingViewModel}}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>

</ContentPage>
