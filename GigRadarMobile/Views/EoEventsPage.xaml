<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:GigRadarMobile.ViewModels" xmlns:models="clr-namespace:GigRadarMobile.Models" x:Class="GigRadarMobile.Views.EoEventsPage" x:DataType="vm:EoEventsViewModel" BackgroundColor="{StaticResource BackgroundColor}" Title="Events">
    <ScrollView><VerticalStackLayout Padding="20,18,20,28" Spacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><VerticalStackLayout Spacing="3"><Label Text="EVENT MANAGEMENT" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}"/><Label Text="Event kamu" Style="{StaticResource PageTitle}"/><Label Text="Kelola event dan pantau penjualan dengan cepat." Style="{StaticResource PageSubtitle}"/></VerticalStackLayout><Button Grid.Column="1" Text="＋" FontSize="22" WidthRequest="48" HeightRequest="48" Padding="0" CornerRadius="16" BackgroundColor="{StaticResource PrimaryColor}" TextColor="#09090B" Command="{Binding GoToCreateEventCommand}"/></Grid>
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource PrimaryColor}"/>
        <Label Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" TextColor="{StaticResource DangerColor}" FontSize="13"/>
        <Label Text="Belum ada event. Buat event pertama kamu untuk mulai menjual tiket." IsVisible="{Binding HasEvents, Converter={StaticResource InvertedBoolConverter}}" TextColor="{StaticResource TextSecondary}" FontSize="13"/>
        <CollectionView ItemsSource="{Binding Dashboard.Events}" SelectionMode="None" IsVisible="{Binding HasEvents}"><CollectionView.ItemTemplate><DataTemplate x:DataType="models:EoEventStat">
            <Frame Style="{StaticResource Card}" Margin="0,4"><VerticalStackLayout Spacing="11">
                <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="3"><Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation"/><Label Text="{Binding DateLabel}" FontSize="12" TextColor="{StaticResource TextSecondary}"/></VerticalStackLayout><Border Grid.Column="1" BackgroundColor="{Binding StatusColor}" StrokeThickness="0" Padding="9,5" StrokeShape="RoundRectangle 10"><Label Text="{Binding StatusLabel}" FontSize="10" FontAttributes="Bold" TextColor="White"/></Border></Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Frame BackgroundColor="{StaticResource SurfaceColor}" CornerRadius="12" Padding="12" HasShadow="False" BorderColor="Transparent"><VerticalStackLayout Spacing="2"><Label Text="{Binding SoldLabel}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource WarningColor}"/><Label Text="Tickets" FontSize="10" TextColor="{StaticResource TextMuted}"/></VerticalStackLayout></Frame><Frame Grid.Column="1" BackgroundColor="{StaticResource SurfaceColor}" CornerRadius="12" Padding="12" HasShadow="False" BorderColor="Transparent"><VerticalStackLayout Spacing="2"><Label Text="{Binding RevenueFormatted}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" LineBreakMode="TailTruncation"/><Label Text="Revenue" FontSize="10" TextColor="{StaticResource TextMuted}"/></VerticalStackLayout></Frame></Grid>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><Button Grid.Column="0" Text="{Binding PrimaryActionLabel}" HeightRequest="40" CornerRadius="11" FontSize="12" FontAttributes="Bold" BackgroundColor="{StaticResource PrimaryColor}" TextColor="#09090B" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EoEventsViewModel}}, Path=TogglePrimaryActionCommand}" CommandParameter="{Binding .}"/><Button Grid.Column="1" Text="Selesai" HeightRequest="40" CornerRadius="11" FontSize="11" BackgroundColor="{StaticResource CardElevatedColor}" TextColor="{StaticResource TextSecondary}" IsVisible="{Binding CanMarkCompleted}" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EoEventsViewModel}}, Path=MarkCompletedCommand}" CommandParameter="{Binding .}"/><Button Grid.Column="2" Text="🗑" HeightRequest="40" WidthRequest="42" CornerRadius="11" BackgroundColor="#29171D" TextColor="{StaticResource DangerColor}" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EoEventsViewModel}}, Path=DeleteEventCommand}" CommandParameter="{Binding .}"/></Grid>
            </VerticalStackLayout></Frame>
        </DataTemplate></CollectionView.ItemTemplate></CollectionView>
    </VerticalStackLayout></ScrollView>
</ContentPage>