<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             x:Class="GigRadarMobile.Views.ArtistDetailPage"
             x:DataType="vm:ArtistDetailViewModel"
             BackgroundColor="#121212"
             Title="Artist">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="{Binding Artist.Name}" FontSize="28" FontAttributes="Bold" TextColor="White"/>
            <Label Text="{Binding Artist.Genre}" FontSize="14" TextColor="#7B2FFF"/>
            <Label Text="{Binding Artist.Bio}" FontSize="14" TextColor="#B0B0B0"/>

            <Label Text="&#x1F3B5; TRACKS" FontSize="18" FontAttributes="Bold" TextColor="#39FF14"/>
            <Label Text="{Binding PlaybackStatus}" FontSize="13" TextColor="#B0B0B0"/>

            <CollectionView ItemsSource="{Binding Artist.Tracks}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AudioTrack">
                        <Frame BackgroundColor="#1E1E1E" CornerRadius="10" Padding="14" Margin="0,4" BorderColor="#333333" HasShadow="False">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                                    <Label Text="{Binding DurationSeconds, StringFormat='{0}s preview'}" FontSize="12" TextColor="#B0B0B0"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="&#x25B6;&#xFE0F;" BackgroundColor="#39FF14" TextColor="Black" WidthRequest="44" HeightRequest="44" CornerRadius="22"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArtistDetailViewModel}}, Path=PlayTrackCommand}" CommandParameter="{Binding .}"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
