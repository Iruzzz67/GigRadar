<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             x:Class="GigRadarMobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="GigRadar">

    <ScrollView>
        <VerticalStackLayout Padding="28,32,28,28" Spacing="24" VerticalOptions="Center">

            <!-- Brand hero -->
            <Border Style="{StaticResource HeroBanner}" HeightRequest="200">
                <Grid>
                    <Image Source="art_haze" Aspect="AspectFill"/>
                    <BoxView Background="{StaticResource PosterScrim}"/>
                    <VerticalStackLayout Padding="18" Spacing="6" VerticalOptions="End">
                        <Label Text="MENGHUBUNGKAN SKENA" Style="{StaticResource Overline}"
                               TextColor="{StaticResource PrimaryColor}"/>
                        <Label Text="GIGRADAR" FontFamily="SpaceGroteskBold" FontSize="34" CharacterSpacing="3"
                               TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="Menemukan suara lokal, mempertemukan artist &amp; event organizer."
                               Style="{StaticResource Body}" FontSize="12"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Form -->
            <Border Style="{StaticResource CardBorder}" Padding="20">
                <VerticalStackLayout Spacing="14">

                    <HorizontalStackLayout Spacing="10">
                        <BoxView Style="{StaticResource SectionBar}"/>
                    <Label Style="{StaticResource Title}" FontSize="20" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsRegister}" Value="True">
                                <Setter Property="Text" Value="Daftar akun baru"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsRegister}" Value="False">
                                <Setter Property="Text" Value="Masuk"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    </HorizontalStackLayout>

                    <Entry Text="{Binding Name}" Placeholder="Nama" IsVisible="{Binding IsRegister}"/>

                    <!-- Pilihan role saat daftar (§25): User langsung aktif, Artist/EO menunggu verifikasi admin -->
                    <VerticalStackLayout IsVisible="{Binding IsRegister}" Spacing="8">
                        <Label Text="DAFTAR SEBAGAI" Style="{StaticResource Eyebrow}"/>
                        <HorizontalStackLayout Spacing="12">
                            <RadioButton x:Name="RoleUserRadio" Content="User" GroupName="RoleSelection" CheckedChanged="OnRoleChecked"/>
                            <RadioButton x:Name="RoleArtistRadio" Content="Artist" GroupName="RoleSelection" CheckedChanged="OnRoleChecked"/>
                            <RadioButton x:Name="RoleEoRadio" Content="EO" GroupName="RoleSelection" CheckedChanged="OnRoleChecked"/>
                        </HorizontalStackLayout>
                        <Label Text="{Binding SelectedRoleDescription}" Style="{StaticResource Meta}"/>
                    </VerticalStackLayout>

                    <Entry Text="{Binding Email}" Placeholder="Email" Keyboard="Email"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Grid.Column="0" Text="{Binding Password}" Placeholder="Password" IsPassword="{Binding HidePassword}"/>
                        <Button Grid.Column="1" Text="{Binding ShowPasswordGlyph}" WidthRequest="44" HeightRequest="44" CornerRadius="10"
                                FontSize="16" Padding="0" BackgroundColor="Transparent" TextColor="{StaticResource TextMuted}"
                                Command="{Binding TogglePasswordCommand}"
                                SemanticProperties.Description="{Binding ShowPasswordSemantic}"/>
                    </Grid>

                    <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HeightRequest="20"/>

                    <Button Style="{StaticResource BtnPrimary}" HeightRequest="50" Command="{Binding LoginCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsRegister}" Value="True">
                                <Setter Property="Text" Value="Daftar"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsRegister}" Value="False">
                                <Setter Property="Text" Value="Masuk"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Label Style="{StaticResource Caption}" HorizontalOptions="Center" TextColor="{StaticResource PrimaryColor}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleModeCommand}"/>
                        </Label.GestureRecognizers>
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsRegister}" Value="True">
                                <Setter Property="Text" Value="Sudah punya akun? Masuk"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsRegister}" Value="False">
                                <Setter Property="Text" Value="Belum punya akun? Daftar"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>