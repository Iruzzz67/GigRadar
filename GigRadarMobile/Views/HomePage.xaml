<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             xmlns:behaviors="clr-namespace:GigRadarMobile.Behaviors"
             x:Class="GigRadarMobile.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Shell.NavBarIsVisible="False"
             Title="Discover">

    <RefreshView Command="{Binding LoadEventsCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <ScrollView.Behaviors>
                <behaviors:ParallaxBehavior Target="{x:Reference HeroArt}" Factor="0.4"/>
            </ScrollView.Behaviors>
            <VerticalStackLayout Padding="20,16,20,32" Spacing="30">

                <!-- ===== Header ===== -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="GIGRADAR" FontFamily="SpaceGroteskBold" FontSize="22" CharacterSpacing="2.5"
                               TextColor="{StaticResource TextPrimary}"/>
                        <Button Text="{Binding CityLabel, StringFormat='{0} ▾'}" Padding="0" HeightRequest="36"
                                HorizontalOptions="Start" FontFamily="InterMedium" FontSize="13"
                                TextColor="{StaticResource TextSecondary}" BackgroundColor="Transparent"
                                Command="{Binding ChangeCityCommand}"
                                SemanticProperties.Description="Ubah kota untuk rekomendasi dan radar"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Style="{StaticResource AvatarRing}" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToProfileCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Initials}" FontFamily="SpaceGroteskBold" FontSize="15"
                               TextColor="{StaticResource PrimaryColor}" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center"/>

                <!-- ===== Error state (empty != error) ===== -->
                <Border IsVisible="{Binding HasError}" Style="{StaticResource CardBorder}"
                        Background="{StaticResource DangerSoft}" Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource Body}" TextColor="{StaticResource DangerColor}"/>
                        <Button Text="Coba lagi" Style="{StaticResource BtnOutline}" HeightRequest="42"
                                Command="{Binding LoadEventsCommand}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ===== Hero ===== -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding HasFeatured}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <BoxView WidthRequest="24" HeightRequest="2" Color="{StaticResource StagePink}" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding GreetingEyebrow}" Style="{StaticResource StageEyebrow}"/>
                    </Grid>
                    <Label Text="Apa yang lagi rame malam ini?"
                           Style="{StaticResource HeroTitle}" FontSize="28"/>

                    <Border Style="{StaticResource HeroBanner}" HeightRequest="360">
                        <Border.Behaviors>
                            <behaviors:EntranceAnimationBehavior FromOffset="22" Duration="380"/>
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToDetailCommand}" CommandParameter="{Binding FeaturedEvent}"/>
                        </Border.GestureRecognizers>
                        <Grid>
                            <Image x:Name="HeroArt"
                                   Source="{Binding FeaturedEvent.PosterUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter={Binding FeaturedEvent.Name}}"
                                   Aspect="AspectFill"/>
                            <BoxView Background="{StaticResource PosterScrim}"/>

                            <!-- Aksen genre di tepi kiri poster -->
                            <BoxView WidthRequest="5" HorizontalOptions="Start"
                                     Background="{StaticResource SignalGradient}"/>

                            <VerticalStackLayout Padding="18" Spacing="10" VerticalOptions="End">
                                <Label Text="LIVE PICK • GIGRADAR" Style="{StaticResource Overline}"
                                       TextColor="{StaticResource StageAmber}"/>
                                <HorizontalStackLayout Spacing="8">
                                    <Border Style="{StaticResource Pill}"
                                            IsVisible="{Binding FeaturedEvent.GenreName, Converter={StaticResource StringNotEmptyConverter}}">
                                        <Label Text="{Binding FeaturedEvent.GenreName}" Style="{StaticResource PillText}"/>
                                    </Border>
                                    <Border Style="{StaticResource Pill}" IsVisible="{Binding FeaturedEvent.ShowsStatusBadge}"
                                            BackgroundColor="{Binding FeaturedEvent.StatusColor}">
                                        <Label Text="{Binding FeaturedEvent.StatusLabel}" Style="{StaticResource PillTextAccent}"/>
                                    </Border>
                                </HorizontalStackLayout>

                                <Label Text="{Binding FeaturedEvent.Name}" Style="{StaticResource Title}" FontSize="25"
                                       MaxLines="2" LineBreakMode="TailTruncation"/>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                        <Label Text="{Binding FeaturedEvent.VenueName}" Style="{StaticResource Caption}"/>
                                        <Label Text="•" TextColor="{StaticResource TextMuted}"/>
                                        <Label Text="{Binding FeaturedEvent.DateFormatted}" Style="{StaticResource Caption}"/>
                                    </HorizontalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding FeaturedEvent.PriceFormatted}"
                                           Style="{StaticResource Numeric}" FontSize="13"
                                           TextColor="{StaticResource PrimaryColor}"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- ===== Dekat kamu ===== -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <HorizontalStackLayout Grid.Column="0" Spacing="10">
                            <BoxView Style="{StaticResource SectionBar}"/>
                            <Label Text="Dekat kamu" Style="{StaticResource SectionTitleStrong}"/>
                        </HorizontalStackLayout>
                        <Button Grid.Column="1" Text="Semua" Style="{StaticResource TextLink}"
                                Command="{Binding GoToRadarCommand}"/>
                    </Grid>

                    <CollectionView ItemsSource="{Binding NearbyEvents}" HeightRequest="268" ItemsLayout="HorizontalList"
                                    HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:GigEvent">
                                <Border WidthRequest="172" Margin="0,0,14,0" Style="{StaticResource PosterCard}">
                                    <Border.Behaviors>
                                        <behaviors:EntranceAnimationBehavior FromOffset="18"/>
                                    </Border.Behaviors>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=GoToDetailCommand, x:DataType={x:Type vm:HomeViewModel}}" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="152,*">
                                        <Grid Grid.Row="0">
                                            <Image Source="{Binding PosterUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter={Binding Name}}"
                                                   Aspect="AspectFill"/>
                                            <BoxView Background="{StaticResource PosterScrimSoft}"/>
                                            <BoxView WidthRequest="4" HorizontalOptions="Start"
                                                     Color="{Binding GenreName, Converter={StaticResource GenreAccentConverter}, ConverterParameter=accent}"/>
                                            <Border Style="{StaticResource Pill}" HorizontalOptions="Start" VerticalOptions="Start"
                                                    Margin="10" BackgroundColor="#CC0B0A0E">
                                                <Label Text="{Binding StartDate, Converter={StaticResource RelativeDayConverter}}"
                                                       Style="{StaticResource PillText}" FontSize="10"/>
                                            </Border>
                                        </Grid>
                                        <VerticalStackLayout Grid.Row="1" Padding="12,10,12,14" Spacing="4">
                                            <Label Text="{Binding Name}" Style="{StaticResource Subheading}" FontSize="14"
                                                   MaxLines="1" LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding VenueName}" Style="{StaticResource Meta}" MaxLines="1"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding PriceFormatted}" Style="{StaticResource Numeric}" FontSize="12"
                                                   TextColor="{StaticResource PrimaryColor}"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- ===== Artist untuk kamu ===== -->
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="10">
                        <BoxView Style="{StaticResource SectionBar}"/>
                        <Label Text="Artist yang perlu kamu dengerin" Style="{StaticResource SectionTitleStrong}"/>
                    </HorizontalStackLayout>

                    <CollectionView ItemsSource="{Binding Artists}" HeightRequest="216" ItemsLayout="HorizontalList"
                                    HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Artist">
                                <Border WidthRequest="144" Margin="0,0,14,0" Style="{StaticResource ArtistCard}">
                                    <Border.Behaviors>
                                        <behaviors:EntranceAnimationBehavior FromOffset="18" Delay="60"/>
                                    </Border.Behaviors>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=GoToArtistCommand, x:DataType={x:Type vm:HomeViewModel}}" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="132,*">
                                        <Grid Grid.Row="0">
                                            <Image Source="{Binding PhotoUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter={Binding Name}}"
                                                   Aspect="AspectFill"/>
                                            <BoxView Background="{StaticResource PosterScrimSoft}"/>
                                            <Border HorizontalOptions="Start" VerticalOptions="End" Margin="10"
                                                    WidthRequest="34" HeightRequest="34" StrokeThickness="1.5"
                                                    Stroke="#66FFFFFF" StrokeShape="RoundRectangle 999"
                                                    BackgroundColor="#CC0B0A0E">
                                                <Label Text="{Binding Initials}" FontFamily="SpaceGroteskBold" FontSize="12"
                                                       TextColor="{StaticResource TextPrimary}"
                                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                        </Grid>
                                        <VerticalStackLayout Grid.Row="1" Padding="12,10,12,14" Spacing="5">
                                            <Label Text="{Binding Name}" Style="{StaticResource Subheading}" FontSize="14"
                                                   MaxLines="1" LineBreakMode="TailTruncation"/>
                                            <HorizontalStackLayout Spacing="6">
                                                <BoxView WidthRequest="14" HeightRequest="3" CornerRadius="2"
                                                         VerticalOptions="Center"
                                                         Color="{Binding Genre, Converter={StaticResource GenreAccentConverter}, ConverterParameter=accent}"/>
                                                <Label Text="{Binding Genre}" Style="{StaticResource Meta}" MaxLines="1"
                                                       LineBreakMode="TailTruncation"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- ===== Radar teaser ===== -->
                <Border Style="{StaticResource HeroBanner}" HeightRequest="230">
                    <Grid>
                        <Image Source="art_ripple" Aspect="AspectFill" Opacity="0.45"/>
                        <BoxView Background="{StaticResource PosterScrimSoft}"/>
                        <VerticalStackLayout Padding="16" Spacing="10" VerticalOptions="End">
                            <Label Text="RADAR / LIVE SIGNAL" Style="{StaticResource Eyebrow}"/>
                            <Label Text="Gig di sekitar kamu" Style="{StaticResource Subheading}" FontSize="18"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <GraphicsView Grid.Column="0" Drawable="{Binding TeaserRadar}" HeightRequest="120"/>
                                <Button Grid.Column="1" Text="Buka radar" Style="{StaticResource BtnSmall}"
                                        BackgroundColor="{StaticResource PrimaryColor}" TextColor="{StaticResource OnAccent}"
                                        VerticalOptions="End" Command="{Binding GoToRadarCommand}"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ===== Minggu ini ===== -->
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="10">
                        <BoxView Style="{StaticResource SectionBar}"/>
                        <Label Text="Minggu ini" Style="{StaticResource SectionTitleStrong}"/>
                    </HorizontalStackLayout>
                    <Label Text="Belum ada event akhir pekan ini. Coba geser radius di Radar."
                           Style="{StaticResource Body}" IsVisible="{Binding HasWeekendEvents, Converter={StaticResource InvertedBoolConverter}}"/>

                    <CollectionView ItemsSource="{Binding WeekendEvents}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:GigEvent">
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="14">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=GoToDetailCommand, x:DataType={x:Type vm:HomeViewModel}}" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <Grid Grid.Column="0" WidthRequest="52" HeightRequest="52">
                                            <Image Source="{Binding PosterUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter={Binding Name}}"
                                                   Aspect="AspectFill"/>
                                            <BoxView Background="{StaticResource PosterScrimSoft}"/>
                                            <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                                <Label Text="{Binding StartDate, StringFormat='{0:dd}'}" Style="{StaticResource Numeric}"
                                                       FontSize="19" HorizontalTextAlignment="Center"/>
                                                <Label Text="{Binding StartDate, StringFormat='{0:MMM}'}" FontSize="9" FontAttributes="Bold"
                                                       CharacterSpacing="1" TextColor="{StaticResource TextSecondary}"
                                                       HorizontalTextAlignment="Center"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" Style="{StaticResource Subheading}" FontSize="15"
                                                   MaxLines="1" LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding VenueName}" Style="{StaticResource Caption}" MaxLines="1"
                                                   LineBreakMode="TailTruncation"/>
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding TimeFormatted}" Style="{StaticResource Meta}"/>
                                                <Label Text="{Binding StartDate, Converter={StaticResource RelativeDayConverter}}"
                                                       Style="{StaticResource Meta}"
                                                       TextColor="{Binding GenreName, Converter={StaticResource GenreAccentConverter}, ConverterParameter=accent}"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding PriceFormatted}" Style="{StaticResource Numeric}"
                                               FontSize="13" TextColor="{StaticResource PrimaryColor}" VerticalOptions="Center"
                                               LineBreakMode="TailTruncation"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- ===== Genre ===== -->
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="10">
                        <BoxView Style="{StaticResource SectionBar}"/>
                        <Label Text="Jelajah genre" Style="{StaticResource SectionTitleStrong}"/>
                    </HorizontalStackLayout>
                    <Label Text="Pilih genre — Radar langsung disaring untuk kamu." Style="{StaticResource Body}"/>

                    <CollectionView ItemsSource="{Binding GenreChips}" HeightRequest="40"
                                    ItemsLayout="HorizontalList" HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Margin="0,0,8,0" StrokeThickness="1" StrokeShape="RoundRectangle 999"
                                        Padding="16,8"
                                        BackgroundColor="{Binding ., Converter={StaticResource GenreAccentConverter}, ConverterParameter=tint}"
                                        Stroke="{Binding ., Converter={StaticResource GenreAccentConverter}, ConverterParameter=accent}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=GoToGenreRadarCommand, x:DataType={x:Type vm:HomeViewModel}}" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding .}" FontFamily="InterMedium" FontSize="13"
                                           TextColor="{Binding ., Converter={StaticResource GenreAccentConverter}, ConverterParameter=accent}"/>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
