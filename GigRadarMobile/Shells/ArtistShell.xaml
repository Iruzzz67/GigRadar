<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:GigRadarMobile.Views"
       x:Class="GigRadarMobile.Shells.ArtistShell"
       Shell.FlyoutBehavior="Disabled"
       Title="GigRadar Artist">

    <!-- GIGRADAR_APP_SPEC.md Bab 55 — ArtistShell
         Dashboard memakai data nyata (GET /api/artist/me/dashboard).
         Tab Music / Posts / Gigs (manajemen konten) menyusul di Phase 3. -->
    <TabBar>
        <ShellContent Title="Dashboard" ContentTemplate="{DataTemplate views:ArtistDashboardPage}" Route="artist-dashboard"/>
        <ShellContent Title="Undangan" ContentTemplate="{DataTemplate views:InvitationsPage}" Route="artist-invitations"/>
        <ShellContent Title="Merch" ContentTemplate="{DataTemplate views:MerchPage}" Route="artist-merch"/>
                <ShellContent Title="Notifikasi" ContentTemplate="{DataTemplate views:NotificationsPage}" Route="artistshell-notifications"/>
<ShellContent Title="Profile" ContentTemplate="{DataTemplate views:ProfilePage}" Route="profile"/>
    </TabBar>

</Shell>