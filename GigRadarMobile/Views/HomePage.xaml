<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             x:Class="GigRadarMobile.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             BackgroundColor="#121212"
             Title="Discover">

    <RefreshView Command="{Binding LoadEventsCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="20">

                <Label Text="🎸 GigRadar" FontSize="28" FontAttributes="Bold" TextColor="#39FF14"/>
                <Label Text="{Binding UserName, StringFormat='Halo, {0}!'}" FontSize="14" TextColor="#B0B0B0"/>

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#39FF14"/>

                <!-- Recommended For You -->
                <Label Text="🎯 Recommended For You" FontSize="18" FontAttributes="Bold" TextColor="#7B2FFF"/>
                <CollectionView ItemsSource="{Binding RecommendedEvents}" HeightRequest="220" ItemsLayout="HorizontalList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:GigEvent">
                            <Frame WidthRequest="260" BackgroundColor="#1E1E1E" CornerRadius="12" Padding="16" Margin="0,0,12,0" HasShadow="False">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=GoToDetailCommand}" CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                                    <Label Text="{Binding StatusLabel}" FontSize="11" FontAttributes="Bold"
                                           TextColor="{Binding StatusColor}" IsVisible="{Binding ShowsStatusBadge}"/>
                                    <Label Text="{Binding DateFormatted}" FontSize="13" TextColor="#B0B0B0"/>
                                    <Label Text="{Binding VenueName}" FontSize="13" TextColor="#B0B0B0"/>
                                    <Label Text="{Binding PriceFormatted}" FontSize="14" TextColor="#39FF14" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Tonight -->
                <Label Text="🌙 Tonight" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                <CollectionView ItemsSource="{Binding TonightEvents}" HeightRequest="200" ItemsLayout="HorizontalList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:GigEvent">
                            <Frame WidthRequest="240" BackgroundColor="#1E1E1E" CornerRadius="12" Padding="14" Margin="0,0,12,0" HasShadow="False">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=GoToDetailCommand}" CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                                    <Label Text="{Binding StatusLabel}" FontSize="11" FontAttributes="Bold"
                                           TextColor="{Binding StatusColor}" IsVisible="{Binding ShowsStatusBadge}"/>
                                    <Label Text="{Binding TimeFormatted}" FontSize="13" TextColor="#39FF14"/>
                                    <Label Text="{Binding PriceFormatted}" FontSize="13" TextColor="#B0B0B0"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- This Weekend -->
                <Label Text="📅 This Weekend" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                <CollectionView ItemsSource="{Binding WeekendEvents}" HeightRequest="200" ItemsLayout="HorizontalList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:GigEvent">
                            <Frame WidthRequest="240" BackgroundColor="#1E1E1E" CornerRadius="12" Padding="14" Margin="0,0,12,0" HasShadow="False">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=GoToDetailCommand}" CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                                    <Label Text="{Binding StatusLabel}" FontSize="11" FontAttributes="Bold"
                                           TextColor="{Binding StatusColor}" IsVisible="{Binding ShowsStatusBadge}"/>
                                    <Label Text="{Binding DateFormatted}" FontSize="13" TextColor="#B0B0B0"/>
                                    <Label Text="{Binding VenueName}" FontSize="13" TextColor="#B0B0B0"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Nearby -->
                <Label Text="📍 Nearby Gigs" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                <CollectionView ItemsSource="{Binding NearbyEvents}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:GigEvent">
                            <Frame BackgroundColor="#1E1E1E" CornerRadius="12" Padding="16" Margin="0,4" HasShadow="False">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=GoToDetailCommand}" CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                                        <Label Text="{Binding StatusLabel}" FontSize="11" FontAttributes="Bold"
                                               TextColor="{Binding StatusColor}" IsVisible="{Binding ShowsStatusBadge}"/>
                                        <Label Text="{Binding DateFormatted}" FontSize="13" TextColor="#B0B0B0"/>
                                        <Label Text="{Binding VenueName}" FontSize="12" TextColor="#666666"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding PriceFormatted}" FontSize="13" TextColor="#39FF14" FontAttributes="Bold" VerticalOptions="Center"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
