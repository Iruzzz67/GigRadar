<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             x:Class="GigRadarMobile.Views.OnboardingPage"
             x:DataType="vm:OnboardingViewModel"
             BackgroundColor="#121212"
             Title="Onboarding">

    <VerticalStackLayout Padding="20" Spacing="16">

        <Label Text="🎵 Pilih Genre Favorit" FontSize="24" FontAttributes="Bold" TextColor="White"/>
        <Label Text="Pilih genre musik yang kamu sukai" FontSize="14" TextColor="#B0B0B0"/>

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#39FF14"/>

        <CollectionView ItemsSource="{Binding Genres}" SelectionMode="None" HeightRequest="400">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Genre">
                    <Frame BackgroundColor="#1E1E1E" CornerRadius="10" Padding="14" Margin="0,4" BorderColor="#333333" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OnboardingViewModel}}, Path=ToggleGenreCommand}" CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{Binding Icon}" FontSize="24" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding Name}" FontSize="16" TextColor="White" VerticalOptions="Center"/>
                            <BoxView Grid.Column="2" WidthRequest="24" HeightRequest="24" CornerRadius="12" Color="#333333" VerticalOptions="Center"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Continue →" BackgroundColor="#39FF14" TextColor="Black" FontAttributes="Bold" CornerRadius="10" HeightRequest="50" Command="{Binding FinishOnboardingCommand}"/>

    </VerticalStackLayout>

</ContentPage>
