<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             x:Class="GigRadarMobile.Views.ArtistGigsPage"
             x:DataType="vm:ArtistGigsViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Cari Gig">
    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
        <ScrollView>
            <VerticalStackLayout Padding="20,18,20,28" Spacing="16">

                <Border Style="{StaticResource PageHero}" Padding="18">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="GIG MARKETPLACE" Style="{StaticResource Overline}" TextColor="{StaticResource StageCyan}"/>
                        <Label Text="Cari gig" Style="{StaticResource HeroTitle}" FontSize="26"/>
                        <Label Text="Lamar slot artist yang dibuka Event Organizer." Style="{StaticResource Body}" FontSize="13"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="FILTER GIG" Style="{StaticResource Eyebrow}"/>
                        <Entry Placeholder="Cari gig, event, venue, atau kota" Text="{Binding SearchText}" ReturnCommand="{Binding SearchCommand}" SemanticProperties.Description="Kata kunci pencarian gig"/>
                        <Picker Title="Semua genre" ItemsSource="{Binding GenreNames}" SelectedItem="{Binding SelectedGenreName}" SemanticProperties.Description="Filter genre gig"/>
                        <Entry Placeholder="Pesan lamaran (opsional, dikirim saat melamar)" Text="{Binding ApplyMessage}" MaxLength="1000" SemanticProperties.Description="Pesan lamaran"/>
                        <Button Text="Terapkan filter" Style="{StaticResource BtnPrimary}" HeightRequest="44" Command="{Binding SearchCommand}" IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource PrimaryColor}"/>
                <Label Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" TextColor="{StaticResource DangerColor}" FontSize="13"/>
                <Button Text="Coba muat ulang" Command="{Binding LoadCommand}" IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" BackgroundColor="{StaticResource CardElevatedColor}" TextColor="{StaticResource TextPrimary}"/>

                <Label Text="Gig terbuka" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                <Label Text="Belum ada gig yang cocok. Lengkapi profil dan coba filter lain — gig baru akan muncul di sini."
                       IsVisible="{Binding ShowEmptyState}" TextColor="{StaticResource TextSecondary}" FontSize="13"/>
                <CollectionView ItemsSource="{Binding Gigs}" IsVisible="{Binding HasGigs}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:GigItem">
                            <Border Style="{StaticResource Card}" Padding="15" Margin="0,3">
                                <VerticalStackLayout Spacing="7">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                            <Label Text="{Binding EventLabel}" FontSize="12" TextColor="{StaticResource TextSecondary}" IsVisible="{Binding EventLabel, Converter={StaticResource StringNotEmptyConverter}}"/>
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" Padding="8,4" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{Binding StatusColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                                            <Label Text="{Binding StatusLabel}" FontSize="10" TextColor="{Binding StatusColor}"/>
                                        </Border>
                                    </Grid>
                                    <Label Text="{Binding ScheduleLabel}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                                    <Label Text="{Binding LocationLabel}" FontSize="12" TextColor="{StaticResource TextSecondary}" IsVisible="{Binding LocationLabel, Converter={StaticResource StringNotEmptyConverter}}"/>
                                    <Label Text="{Binding BudgetLabel}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}"/>
                                    <Label Text="{Binding Requirements}" FontSize="12" TextColor="{StaticResource TextSecondary}" IsVisible="{Binding Requirements, Converter={StaticResource StringNotEmptyConverter}}"/>
                                    <Label Text="{Binding ApplicantLabel}" FontSize="11" TextColor="{StaticResource TextMuted}"/>
                                    <Button Text="{Binding ApplyLabel}" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArtistGigsViewModel}}, Path=ApplyCommand, x:DataType={x:Type vm:ArtistGigsViewModel}}" CommandParameter="{Binding .}"
                                            IsEnabled="{Binding CanApply}" HeightRequest="44" CornerRadius="12" FontSize="13" FontAttributes="Bold"
                                            BackgroundColor="{StaticResource PrimaryColor}" TextColor="{StaticResource OnAccent}"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Lamaran saya" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                <Label Text="Belum ada lamaran. Lamar gig di atas untuk mulai berkomunikasi dengan EO."
                       IsVisible="{Binding ShowApplicationsEmpty}" TextColor="{StaticResource TextSecondary}" FontSize="13"/>
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding MyApplications}" IsVisible="{Binding HasApplications}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:GigApplicationItem">
                            <Border Style="{StaticResource Card}" Padding="15">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding TargetLabel}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                            <Label Text="{Binding AppliedLabel}" FontSize="11" TextColor="{StaticResource TextMuted}"/>
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" Padding="8,4" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{Binding StatusColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                                            <Label Text="{Binding StatusLabel}" FontSize="10" TextColor="{Binding StatusColor}"/>
                                        </Border>
                                    </Grid>
                                    <Label Text="{Binding Message}" FontSize="12" TextColor="{StaticResource TextSecondary}" IsVisible="{Binding Message, Converter={StaticResource StringNotEmptyConverter}}"/>
                                    <Button Text="Tarik lamaran" IsVisible="{Binding CanWithdraw}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArtistGigsViewModel}}, Path=WithdrawCommand, x:DataType={x:Type vm:ArtistGigsViewModel}}" CommandParameter="{Binding .}"
                                            HeightRequest="42" CornerRadius="11" FontSize="12" BackgroundColor="{StaticResource CardElevatedColor}" TextColor="{StaticResource DangerColor}"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
