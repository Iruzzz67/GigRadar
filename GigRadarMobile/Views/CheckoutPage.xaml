<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             x:Class="GigRadarMobile.Views.CheckoutPage"
             x:DataType="vm:CheckoutViewModel"
             BackgroundColor="#121212"
             Title="Pembayaran">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Ringkasan pesanan -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="12" Padding="16" BorderColor="#333333" HasShadow="False">
                <VerticalStackLayout Spacing="6">
                    <Label Text="&#x1F3AB; RINGKASAN PESANAN" FontSize="13" FontAttributes="Bold" TextColor="#7B2FFF"/>
                    <Label Text="{Binding EventName}" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="{Binding EventDate, StringFormat='&#x1F4C5; {0}'}" FontSize="14" TextColor="#B0B0B0"/>
                    <Label Text="{Binding VenueName, StringFormat='&#x1F3EA; {0}'}" FontSize="14" TextColor="#B0B0B0"/>
                    <BoxView HeightRequest="1" Color="#333333" Margin="0,6"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding TypeName}" FontSize="14" TextColor="White"/>
                        <Label Grid.Column="1" Text="{Binding PriceFormatted}" FontSize="15" FontAttributes="Bold" TextColor="#39FF14"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Data diri pembeli -->
            <Label Text="&#x1F464; DATA DIRI PEMBELI" FontSize="13" FontAttributes="Bold" TextColor="#7B2FFF" Margin="0,6,0,0"/>
            <Label Text="Isi data diri untuk verifikasi kelayakan pembelian tiket." FontSize="12" TextColor="#888888"/>

            <VerticalStackLayout Spacing="10">
                <Label Text="Nama Lengkap" FontSize="13" TextColor="#B0B0B0"/>
                <Entry Text="{Binding FullName}" Placeholder="Nama sesuai KTP"
                       BackgroundColor="#1E1E1E" TextColor="White" PlaceholderColor="#666666"/>

                <Label Text="Nomor Telepon" FontSize="13" TextColor="#B0B0B0"/>
                <Entry Text="{Binding Phone}" Placeholder="08xxxxxxxxxx" Keyboard="Telephone"
                       BackgroundColor="#1E1E1E" TextColor="White" PlaceholderColor="#666666"/>

                <Label Text="Email" FontSize="13" TextColor="#B0B0B0"/>
                <Entry Text="{Binding Email}" Placeholder="email@contoh.com" Keyboard="Email"
                       BackgroundColor="#1E1E1E" TextColor="White" PlaceholderColor="#666666"/>

                <Label Text="Tanggal Lahir" FontSize="13" TextColor="#B0B0B0"/>
                <DatePicker Date="{Binding BirthDate}" MaximumDate="{x:Static sys:DateTime.Today}"
                            TextColor="White" BackgroundColor="#1E1E1E"
                            Format="dd MMM yyyy" FontSize="15"/>
            </VerticalStackLayout>

            <!-- Pembayaran -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="12" Padding="16" BorderColor="#7B2FFF" HasShadow="False" Margin="0,10,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="&#x1F4B3; PEMBAYARAN" FontSize="13" FontAttributes="Bold" TextColor="#7B2FFF"/>
                    <Label Text="Metode: Transfer Bank / E-Wallet (simulasi)" FontSize="13" TextColor="#B0B0B0"/>
                    <Button Text="Bayar Sekarang" BackgroundColor="#39FF14" TextColor="Black" FontAttributes="Bold"
                            CornerRadius="10" HeightRequest="52"
                            Command="{Binding PayCommand}"/>
                    <ActivityIndicator IsRunning="{Binding IsProcessing}" IsVisible="{Binding IsProcessing}"
                                       Color="#39FF14" HeightRequest="24"/>
                    <Label Text="Dengan membayar, kamu menyetujui syarat &amp; ketentuan tiket." FontSize="11" TextColor="#666666" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>