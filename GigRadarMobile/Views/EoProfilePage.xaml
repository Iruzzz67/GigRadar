<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             x:Class="GigRadarMobile.Views.EoProfilePage"
             x:DataType="vm:EoProfileViewModel"
             BackgroundColor="#121212"
             Title="Profil EO">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Header -->
            <Frame BackgroundColor="#2A2A2A" CornerRadius="50" WidthRequest="90" HeightRequest="90"
                   HorizontalOptions="Center" Padding="0" HasShadow="False">
                <Label Text="🎤" FontSize="44" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Frame>

            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding UserName}" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                <Label Text="{Binding UserEmail}" FontSize="13" TextColor="#B0B0B0" HorizontalOptions="Center"/>
                <Label Text="{Binding RoleBadge}" FontSize="12" FontAttributes="Bold"
                       TextColor="{Binding RoleBadgeColor}" HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#333333" Margin="0,4"/>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#39FF14"/>
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   TextColor="#FF6B6B" FontSize="13" HorizontalTextAlignment="Center"/>

            <!-- Edit Data Diri -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="12" Padding="16" BorderColor="#333333" HasShadow="False"
                   IsVisible="{Binding IsEditing}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Edit Data Diri" FontSize="17" FontAttributes="Bold" TextColor="#39FF14"/>
                    <Entry Text="{Binding UserName}" Placeholder="Nama lengkap" BackgroundColor="#2A2A2A"
                           TextColor="White" PlaceholderColor="#666666"/>
                    <Entry Text="{Binding UserCity}" Placeholder="Kota" BackgroundColor="#2A2A2A"
                           TextColor="White" PlaceholderColor="#666666"/>
                    <Entry Text="{Binding UserPhotoUrl}" Placeholder="URL foto profil (opsional)" BackgroundColor="#2A2A2A"
                           TextColor="White" PlaceholderColor="#666666"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="Batal" BackgroundColor="#333333" TextColor="#B0B0B0"
                                CornerRadius="10" HeightRequest="46" Command="{Binding ToggleEditCommand}"/>
                        <Button Grid.Column="1" Text="Simpan" BackgroundColor="#39FF14" TextColor="Black"
                                FontAttributes="Bold" CornerRadius="10" HeightRequest="46"
                                Command="{Binding SaveProfileCommand}"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Button Text="✏️ Edit Data Diri" BackgroundColor="#7B2FFF" TextColor="White" FontAttributes="Bold"
                    CornerRadius="10" HeightRequest="48" Command="{Binding ToggleEditCommand}"/>

            <!-- Ringkasan statistik -->
            <Label Text="Ringkasan Event" FontSize="18" FontAttributes="Bold" TextColor="White" Margin="0,8,0,0"/>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#1E1E1E" CornerRadius="12" Padding="14"
                       BorderColor="#333333" HasShadow="False">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Dashboard.TotalEvents}" FontSize="24" FontAttributes="Bold" TextColor="#39FF14"/>
                        <Label Text="Total Event" FontSize="12" TextColor="#B0B0B0"/>
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#1E1E1E" CornerRadius="12" Padding="14"
                       BorderColor="#333333" HasShadow="False">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Dashboard.UpcomingEvents}" FontSize="24" FontAttributes="Bold" TextColor="#7B2FFF"/>
                        <Label Text="Event Mendatang" FontSize="12" TextColor="#B0B0B0"/>
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="#1E1E1E" CornerRadius="12" Padding="14"
                       BorderColor="#333333" HasShadow="False">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Dashboard.TotalTicketsSold}" FontSize="24" FontAttributes="Bold" TextColor="#FFB020"/>
                        <Label Text="Tiket Terjual" FontSize="12" TextColor="#B0B0B0"/>
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="#1E1E1E" CornerRadius="12" Padding="14"
                       BorderColor="#333333" HasShadow="False">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Dashboard.TotalRevenueFormatted}" FontSize="18" FontAttributes="Bold" TextColor="#39FF14" LineBreakMode="TailTruncation"/>
                        <Label Text="Pendapatan" FontSize="12" TextColor="#B0B0B0"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <Button Text="➕ Buat Event Baru" BackgroundColor="#39FF14" TextColor="Black" FontAttributes="Bold"
                    CornerRadius="10" HeightRequest="48" Command="{Binding GoToCreateEventCommand}"/>

            <Button Text="🎟️ Kelola Tiket Event" BackgroundColor="#7B2FFF" TextColor="White" FontAttributes="Bold"
                    CornerRadius="10" HeightRequest="48" Command="{Binding GoToManageTicketsCommand}"/>

            <!-- Daftar event miliknya -->
            <Label Text="Event Saya" FontSize="18" FontAttributes="Bold" TextColor="White" Margin="0,8,0,0"/>

            <Label Text="Belum ada event. Event yang kamu buat akan muncul di sini."
                   IsVisible="{Binding HasEvents, Converter={StaticResource InvertedBoolConverter}}"
                   TextColor="#B0B0B0" FontSize="13"/>

            <CollectionView ItemsSource="{Binding Dashboard.Events}" SelectionMode="None" IsVisible="{Binding HasEvents}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:EoEventStat">
                        <Frame BackgroundColor="#1E1E1E" CornerRadius="12" Padding="14" Margin="0,4"
                               BorderColor="#333333" HasShadow="False">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="15" FontAttributes="Bold"
                                           TextColor="White" LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="1" Text="{Binding StatusLabel}" FontSize="11" FontAttributes="Bold"
                                           TextColor="{Binding StatusColor}" VerticalOptions="Center"/>
                                </Grid>
                                <Label Text="{Binding DateLabel}" FontSize="12" TextColor="#B0B0B0"/>
                                <BoxView HeightRequest="1" Color="#2A2A2A"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding SoldLabel}" FontSize="12" TextColor="#FFB020"/>
                                        <Label Text="{Binding TicketTypeCount, StringFormat='{0} tipe tiket'}" FontSize="11" TextColor="#B0B0B0"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                        <Label Text="{Binding RevenueFormatted}" FontSize="14" FontAttributes="Bold"
                                               TextColor="#39FF14" HorizontalTextAlignment="End"/>
                                        <Label Text="Pendapatan" FontSize="11" TextColor="#B0B0B0" HorizontalTextAlignment="End"/>
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#2A2A2A"/>

                                <!-- Aksi: tandai habis/aktifkan, selesai, hapus -->
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Button Grid.Column="0" Text="{Binding PrimaryActionLabel}" FontSize="12" FontAttributes="Bold"
                                            HeightRequest="38" CornerRadius="8" Padding="8,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EoProfileViewModel}}, Path=TogglePrimaryActionCommand}"
                                            CommandParameter="{Binding .}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="BackgroundColor" Value="#39FF14"/>
                                                <Setter Property="TextColor" Value="Black"/>
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding Status}" Value="Published">
                                                        <Setter Property="BackgroundColor" Value="#B34700"/>
                                                        <Setter Property="TextColor" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="1" Text="✅ Selesai" FontSize="12" FontAttributes="Bold" HeightRequest="38"
                                            CornerRadius="8" Padding="12,0" BackgroundColor="#2A2A2A" TextColor="#B0B0B0"
                                            IsVisible="{Binding CanMarkCompleted}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EoProfileViewModel}}, Path=MarkCompletedCommand}"
                                            CommandParameter="{Binding .}"/>
                                    <Button Grid.Column="2" Text="&#x1F5D1;&#xFE0F;" FontSize="12" HeightRequest="38" WidthRequest="44" CornerRadius="8"
                                            BackgroundColor="#3A2020" TextColor="#FF6B6B"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EoProfileViewModel}}, Path=DeleteEventCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>