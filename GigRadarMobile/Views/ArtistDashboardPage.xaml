<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:GigRadarMobile.ViewModels" x:Class="GigRadarMobile.Views.ArtistDashboardPage" x:DataType="vm:ArtistDashboardViewModel" BackgroundColor="{StaticResource BackgroundColor}" Title="GigRadar">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,28" Spacing="18">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Frame Grid.Column="0" WidthRequest="52" HeightRequest="52" CornerRadius="26" Padding="0" HasShadow="False" BackgroundColor="{StaticResource CardElevatedColor}" BorderColor="{StaticResource BorderColor}">
                    <Label Text="🎸" FontSize="25" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="Selamat datang kembali" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                    <Label Text="{Binding UserName}" FontSize="19" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                </VerticalStackLayout>
                <Frame Grid.Column="2" WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0" HasShadow="False" BackgroundColor="{StaticResource CardColor}" BorderColor="{StaticResource BorderColor}">
                    <Label Text="♧" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}"/>
                </Frame>
            </Grid>

            <Frame BackgroundColor="#171A12" CornerRadius="22" Padding="20" HasShadow="False" BorderColor="#38451F">
                <VerticalStackLayout Spacing="12">
                    <Label Text="ARTIST PROFILE" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}"/>
                    <Label Text="Bangun karier. Temukan gig.&#10;Terhubung dengan lebih banyak audience." FontSize="24" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" LineHeight="1.05"/>
                    <Label Text="{Binding UserRole}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                    <Button Text="Lengkapi profil →" HeightRequest="44" CornerRadius="12" BackgroundColor="{StaticResource PrimaryColor}" TextColor="#09090B" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Frame Grid.Column="0" Style="{StaticResource Card}"><VerticalStackLayout Spacing="5"><Label Text="🎵" FontSize="20"/><Label Text="Music" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/><Label Text="Track &amp; album" FontSize="11" TextColor="{StaticResource TextSecondary}"/></VerticalStackLayout></Frame>
                <Frame Grid.Column="1" Style="{StaticResource Card}"><VerticalStackLayout Spacing="5"><Label Text="📍" FontSize="20"/><Label Text="Gigs" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/><Label Text="Jadwal tampil" FontSize="11" TextColor="{StaticResource TextSecondary}"/></VerticalStackLayout></Frame>
            </Grid>
            <Frame Style="{StaticResource Card}"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Label Text="✨" FontSize="22" VerticalOptions="Center"/><VerticalStackLayout Grid.Column="1" Spacing="3"><Label Text="Artist Journey" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/><Label Text="Perkembangan dan pencapaian kamu" FontSize="11" TextColor="{StaticResource TextSecondary}"/></VerticalStackLayout><Label Grid.Column="2" Text="›" FontSize="28" TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/></Grid></Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>