<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             x:Class="GigRadarMobile.Views.EoAnalyticsPage"
             x:DataType="vm:EoAnalyticsViewModel"
             BackgroundColor="#121212"
             Title="Analytics">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="Analytics Penjualan" FontSize="20" FontAttributes="Bold" TextColor="White"/>
            <Label Text="Statistik dari tiket yang benar-benar dibeli." FontSize="12" TextColor="#B0B0B0"/>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#39FF14"/>
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   TextColor="#FF6B6B" FontSize="13" HorizontalTextAlignment="Center"/>

            <!-- Kartu agregat -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#1E1E1E" CornerRadius="12" Padding="14"
                       BorderColor="#333333" HasShadow="False">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Dashboard.TotalTicketsSold}" FontSize="24" FontAttributes="Bold" TextColor="#FFB020"/>
                        <Label Text="Tiket Terjual" FontSize="12" TextColor="#B0B0B0"/>
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#1E1E1E" CornerRadius="12" Padding="14"
                       BorderColor="#333333" HasShadow="False">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Dashboard.TotalRevenueFormatted}" FontSize="18" FontAttributes="Bold"
                               TextColor="#39FF14" LineBreakMode="TailTruncation"/>
                        <Label Text="Total Pendapatan" FontSize="12" TextColor="#B0B0B0"/>
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="#1E1E1E" CornerRadius="12" Padding="14"
                       BorderColor="#333333" HasShadow="False">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Dashboard.TotalEvents}" FontSize="24" FontAttributes="Bold" TextColor="#7B2FFF"/>
                        <Label Text="Total Event" FontSize="12" TextColor="#B0B0B0"/>
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="#1E1E1E" CornerRadius="12" Padding="14"
                       BorderColor="#333333" HasShadow="False">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Dashboard.UpcomingEvents}" FontSize="24" FontAttributes="Bold" TextColor="#39FF14"/>
                        <Label Text="Event Mendatang" FontSize="12" TextColor="#B0B0B0"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <Label Text="Per Event" FontSize="18" FontAttributes="Bold" TextColor="White" Margin="0,8,0,0"/>

            <Label Text="Belum ada data penjualan."
                   IsVisible="{Binding HasData, Converter={StaticResource InvertedBoolConverter}}"
                   TextColor="#B0B0B0" FontSize="13"/>

            <CollectionView ItemsSource="{Binding Dashboard.Events}" SelectionMode="None" IsVisible="{Binding HasData}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:EoEventStat">
                        <Frame BackgroundColor="#1E1E1E" CornerRadius="12" Padding="14" Margin="0,4"
                               BorderColor="#333333" HasShadow="False">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="15" FontAttributes="Bold"
                                           TextColor="White" LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="1" Text="{Binding StatusLabel}" FontSize="11" FontAttributes="Bold"
                                           TextColor="{Binding StatusColor}" VerticalOptions="Center"/>
                                </Grid>
                                <Label Text="{Binding DateLabel}" FontSize="12" TextColor="#B0B0B0"/>
                                <BoxView HeightRequest="1" Color="#2A2A2A"/>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding TicketsSold}" FontSize="18" FontAttributes="Bold" TextColor="#FFB020"/>
                                        <Label Text="Terjual" FontSize="11" TextColor="#B0B0B0"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding RemainingStock}" FontSize="18" FontAttributes="Bold" TextColor="#7B2FFF"/>
                                        <Label Text="Stok" FontSize="11" TextColor="#B0B0B0"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding RevenueFormatted}" FontSize="16" FontAttributes="Bold" TextColor="#39FF14"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="Revenue" FontSize="11" TextColor="#B0B0B0"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <Label Text="{Binding TicketTypeCount, StringFormat='{0} tipe tiket'}" FontSize="11" TextColor="#B0B0B0"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>