<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GigRadarMobile.ViewModels"
             xmlns:models="clr-namespace:GigRadarMobile.Models"
             xmlns:behaviors="clr-namespace:GigRadarMobile.Behaviors"
             x:Class="GigRadarMobile.Views.ExplorePage"
             x:DataType="vm:ExploreViewModel"
             Shell.NavBarIsVisible="False"
             Title="Explore">

    <Grid RowDefinitions="Auto,*">

        <!-- ===== Header: hero + search + filter + view switcher ===== -->
        <VerticalStackLayout Grid.Row="0" Padding="20,16,20,6" Spacing="14">

            <Border Style="{StaticResource PageHero}" HeightRequest="130">
                <Border.Behaviors>
                    <behaviors:EntranceAnimationBehavior FromOffset="20" Duration="380"/>
                </Border.Behaviors>
                <Grid>
                    <Image Source="art_grid" Aspect="AspectFill"/>
                    <BoxView Background="{StaticResource PosterScrim}"/>
                    <VerticalStackLayout Padding="16" Spacing="4" VerticalOptions="End">
                        <Label Text="EXPLORE" Style="{StaticResource Overline}" TextColor="{StaticResource PrimaryColor}"/>
                        <Label Text="Cari gig, artis, venue" Style="{StaticResource HeroTitle}" FontSize="24"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Search -->
            <Border BackgroundColor="{StaticResource CardElevatedColor}" StrokeThickness="1"
                    Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 14" Padding="12,2">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="⌕" FontFamily="SpaceGroteskMedium" FontSize="20"
                           TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                    <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="Event, artist, atau venue…"
                           BackgroundColor="Transparent" HeightRequest="44" FontSize="14"
                           ReturnCommand="{Binding SearchCommand}" ReturnCommandParameter="x"/>
                </Grid>
            </Border>

            <!-- Genre chips -->
            <CollectionView ItemsSource="{Binding GenreFilters}" HeightRequest="40"
                            ItemsLayout="HorizontalList" HorizontalScrollBarVisibility="Never">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GenreFilterItem">
                        <Border Margin="0,0,8,0" Padding="16,8" StrokeThickness="1"
                                StrokeShape="RoundRectangle 999"
                                BackgroundColor="{StaticResource CardElevatedColor}"
                                Stroke="{StaticResource BorderColor}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=SelectGenreCommand, x:DataType={x:Type vm:ExploreViewModel}}" CommandParameter="{Binding Name}"/>
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Name}" FontSize="13" FontFamily="InterMedium"
                                   TextColor="{StaticResource TextSecondary}"/>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                    <Setter Property="Stroke" Value="{StaticResource PrimaryColor}"/>
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Tanggal + radius -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Semua" Style="{StaticResource Chip}" Command="{Binding SelectDateCommand}" CommandParameter="Semua">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding DateFilter}" Value="Semua">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Malam ini" Style="{StaticResource Chip}" Command="{Binding SelectDateCommand}" CommandParameter="Malam ini">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding DateFilter}" Value="Malam ini">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Besok" Style="{StaticResource Chip}" Command="{Binding SelectDateCommand}" CommandParameter="Besok">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding DateFilter}" Value="Besok">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Minggu ini" Style="{StaticResource Chip}" Command="{Binding SelectDateCommand}" CommandParameter="Minggu ini">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding DateFilter}" Value="Minggu ini">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Akhir pekan" Style="{StaticResource Chip}" Command="{Binding SelectDateCommand}" CommandParameter="Akhir pekan">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding DateFilter}" Value="Akhir pekan">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <BoxView WidthRequest="8" Color="Transparent"/>
                    <Button Text="10 km" Style="{StaticResource Chip}" Command="{Binding SelectRadiusCommand}" CommandParameter="10 km">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding RadiusKm}" Value="10">
                                <Setter Property="BackgroundColor" Value="{StaticResource SecondaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="25 km" Style="{StaticResource Chip}" Command="{Binding SelectRadiusCommand}" CommandParameter="25 km">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding RadiusKm}" Value="25">
                                <Setter Property="BackgroundColor" Value="{StaticResource SecondaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="50 km" Style="{StaticResource Chip}" Command="{Binding SelectRadiusCommand}" CommandParameter="50 km">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding RadiusKm}" Value="50">
                                <Setter Property="BackgroundColor" Value="{StaticResource SecondaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Harga -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Semua harga" Style="{StaticResource Chip}" Command="{Binding SelectPriceCommand}" CommandParameter="Semua">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding PriceFilter}" Value="Semua">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Gratis" Style="{StaticResource Chip}" Command="{Binding SelectPriceCommand}" CommandParameter="Gratis">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding PriceFilter}" Value="Gratis">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="&lt;50rb" Style="{StaticResource Chip}" Command="{Binding SelectPriceCommand}" CommandParameter="&lt;50rb">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding PriceFilter}" Value="&lt;50rb">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="&lt;100rb" Style="{StaticResource Chip}" Command="{Binding SelectPriceCommand}" CommandParameter="&lt;100rb">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding PriceFilter}" Value="&lt;100rb">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- View switcher -->
            <Border BackgroundColor="{StaticResource SurfaceColor}" StrokeThickness="1"
                    Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="4">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                    <Button Grid.Column="0" Text="List" FontSize="13" FontFamily="InterSemiBold" HeightRequest="40"
                            CornerRadius="9" BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                            Command="{Binding SetViewModeCommand}" CommandParameter="List">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ViewMode}" Value="List">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="Grid" FontSize="13" FontFamily="InterSemiBold" HeightRequest="40"
                            CornerRadius="9" BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                            Command="{Binding SetViewModeCommand}" CommandParameter="Grid">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ViewMode}" Value="Grid">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2" Text="Radar" FontSize="13" FontFamily="InterSemiBold" HeightRequest="40"
                            CornerRadius="9" BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                            Command="{Binding SetViewModeCommand}" CommandParameter="Radar">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ViewMode}" Value="Radar">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="TextColor" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- ===== Body ===== -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,10,20,32" Spacing="20">

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>

                <!-- Error state -->
                <Border IsVisible="{Binding HasError}" Style="{StaticResource CardBorder}"
                        Background="{StaticResource DangerSoft}" Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource Body}" TextColor="{StaticResource DangerColor}"/>
                        <Button Text="Coba lagi" Style="{StaticResource BtnOutline}" HeightRequest="42"
                                Command="{Binding RetryCommand}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Hasil header -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding HasResults}">
                    <Label Text="{Binding ResultCountLabel}" Style="{StaticResource Caption}" VerticalOptions="Center"/>
                    <Button Grid.Column="1" Text="Bersihkan" Style="{StaticResource TextLink}" IsVisible="{Binding IsFiltered}"
                            Command="{Binding ClearFiltersCommand}"/>
                </Grid>

                <!-- LIST view -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsEventListVisible}">
                    <CollectionView ItemsSource="{Binding Events}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:GigEvent">
                                <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,10">
                                    <Border.Behaviors>
                                        <behaviors:EntranceAnimationBehavior FromOffset="16"/>
                                    </Border.Behaviors>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=GoToDetailCommand, x:DataType={x:Type vm:ExploreViewModel}}" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="96,*" ColumnSpacing="0">
                                        <Grid Grid.Column="0" HeightRequest="96">
                                            <Image Source="{Binding PosterUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter={Binding Name}}"
                                                   Aspect="AspectFill"/>
                                            <BoxView Background="{StaticResource PosterScrimSoft}"/>
                                            <BoxView WidthRequest="4" HorizontalOptions="Start"
                                                     Color="{Binding GenreName, Converter={StaticResource GenreAccentConverter}, ConverterParameter=accent}"/>
                                        </Grid>
                                        <VerticalStackLayout Grid.Column="1" Padding="14,12" Spacing="5">
                                            <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" FontSize="16"
                                                   MaxLines="1" LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding VenueName}" Style="{StaticResource Caption}" MaxLines="1"
                                                   LineBreakMode="TailTruncation"/>
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding DateFormatted}" Style="{StaticResource Meta}"/>
                                                <Label Text="•" TextColor="{StaticResource TextMuted}"/>
                                                <Label Text="{Binding TimeFormatted}" Style="{StaticResource Meta}"/>
                                                <Label Text="{Binding StartDate, Converter={StaticResource RelativeDayConverter}}"
                                                       Style="{StaticResource Meta}"
                                                       TextColor="{Binding GenreName, Converter={StaticResource GenreAccentConverter}, ConverterParameter=accent}"/>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding PriceFormatted}" Style="{StaticResource Numeric}" FontSize="13"
                                                   TextColor="{StaticResource PrimaryColor}"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- GRID view -->
                <CollectionView IsVisible="{Binding IsGridView}" ItemsSource="{Binding Events}" SelectionMode="None"
                                HeightRequest="{Binding GridHeight}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:GigEvent">
                            <Border Style="{StaticResource PosterCard}">
                                <Border.Behaviors>
                                    <behaviors:EntranceAnimationBehavior FromOffset="16"/>
                                </Border.Behaviors>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=GoToDetailCommand, x:DataType={x:Type vm:ExploreViewModel}}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="104,*">
                                    <Grid Grid.Row="0">
                                        <Image Source="{Binding PosterUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter={Binding Name}}"
                                               Aspect="AspectFill"/>
                                        <BoxView Background="{StaticResource PosterScrimSoft}"/>
                                        <Border Style="{StaticResource Pill}" HorizontalOptions="Start" VerticalOptions="End"
                                                Margin="8" BackgroundColor="#CC0B0A0E">
                                            <Label Text="{Binding StartDate, Converter={StaticResource RelativeDayConverter}}"
                                                   Style="{StaticResource PillText}" FontSize="10"/>
                                        </Border>
                                    </Grid>
                                    <VerticalStackLayout Grid.Row="1" Padding="12,10,12,14" Spacing="4">
                                        <Label Text="{Binding Name}" Style="{StaticResource Subheading}" FontSize="13"
                                               MaxLines="2" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding VenueName}" Style="{StaticResource Meta}" MaxLines="1" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding PriceFormatted}" Style="{StaticResource Numeric}" FontSize="12"
                                               TextColor="{StaticResource PrimaryColor}"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- RADAR view -->
                <VerticalStackLayout Spacing="14" IsVisible="{Binding IsRadarView}">
                    <Border Style="{StaticResource PageHero}" HeightRequest="340">
                        <Grid>
                            <Image Source="art_ripple" Aspect="AspectFill" Opacity="0.4"/>
                            <BoxView Background="{StaticResource PosterScrimSoft}"/>
                            <GraphicsView x:Name="ExploreRadarView" HeightRequest="330"
                                          StartInteraction="OnRadarStartInteraction"/>
                            <VerticalStackLayout Padding="14,12" Spacing="2" HorizontalOptions="Start" VerticalOptions="Start">
                                <Label Text="RADAR" Style="{StaticResource Eyebrow}"/>
                                <Label Text="{Binding RadiusKm, StringFormat='Radius {0:0} km'}" Style="{StaticResource Meta}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Label Text="Tap titik untuk lihat detail. Warna = genre, ukuran = popularitas."
                           Style="{StaticResource Meta}" HorizontalTextAlignment="Center"/>

                    <Border IsVisible="{Binding HasSelection}" Style="{StaticResource CardBorder}"
                            Stroke="{StaticResource BorderStrong}" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center" WidthRequest="44">
                                    <Label Text="{Binding SelectedDay}" Style="{StaticResource Numeric}" FontSize="24" HorizontalTextAlignment="Center"/>
                                    <Label Text="{Binding SelectedMonth}" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"
                                           TextColor="{StaticResource TextMuted}" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding SelectedName}" Style="{StaticResource Subheading}" MaxLines="2" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding SelectedMeta}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding SelectedDistance}" Style="{StaticResource Meta}" TextColor="{StaticResource PrimaryColor}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding SelectedPrice}" Style="{StaticResource Numeric}" FontSize="14"
                                       TextColor="{StaticResource PrimaryColor}" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                            </Grid>
                            <Button Text="Lihat detail" Style="{StaticResource BtnSmall}"
                                    BackgroundColor="{StaticResource PrimaryColor}" TextColor="{StaticResource OnAccent}"
                                    HorizontalOptions="End" Command="{Binding GoToSelectedCommand}"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Artist results -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasArtists}">
                    <HorizontalStackLayout Spacing="10">
                        <BoxView Style="{StaticResource SectionBar}"/>
                        <Label Text="Artis" Style="{StaticResource SectionTitleStrong}"/>
                    </HorizontalStackLayout>
                    <CollectionView ItemsSource="{Binding Artists}" HeightRequest="88" ItemsLayout="HorizontalList"
                                    HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Artist">
                                <Border Margin="0,0,10,0" StrokeThickness="1" Stroke="{StaticResource BorderColor}"
                                        StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource CardColor}"
                                        Padding="6,6,14,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=GoToArtistCommand, x:DataType={x:Type vm:ExploreViewModel}}" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 999" Padding="0">
                                            <Image Source="{Binding PhotoUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter={Binding Name}}"
                                                   Aspect="AspectFill"/>
                                        </Border>
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" Style="{StaticResource Subheading}" FontSize="14" MaxLines="1" LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding Genre}" Style="{StaticResource Meta}" FontSize="10"
                                                   TextColor="{Binding Genre, Converter={StaticResource GenreAccentConverter}, ConverterParameter=accent}"/>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Venue results -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasVenues}">
                    <HorizontalStackLayout Spacing="10">
                        <BoxView Style="{StaticResource SectionBar}"/>
                        <Label Text="Venue" Style="{StaticResource SectionTitleStrong}"/>
                    </HorizontalStackLayout>
                    <CollectionView ItemsSource="{Binding Venues}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Venue">
                                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0" Style="{StaticResource IconTile}" WidthRequest="38" HeightRequest="38">
                                            <Label Text="◎" FontSize="17" TextColor="{StaticResource StageCyan}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" Style="{StaticResource Subheading}" FontSize="14" MaxLines="1" LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding City}" Style="{StaticResource Meta}"/>
                                            <Label Text="{Binding Address}" Style="{StaticResource Meta}" FontSize="10" MaxLines="1" LineBreakMode="TailTruncation"/>
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" Text="Peta" Style="{StaticResource BtnSmall}" Padding="12,4"
                                                HeightRequest="30" FontSize="11" BackgroundColor="Transparent"
                                                TextColor="{StaticResource TextMuted}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=OpenVenueMapCommand, x:DataType={x:Type vm:ExploreViewModel}}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Empty state -->
                <Label Text="{Binding EmptyMessage}" Style="{StaticResource Body}" Margin="0,24,0,0"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding HasResults, Converter={StaticResource InvertedBoolConverter}}"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
