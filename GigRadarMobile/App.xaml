<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:GigRadarMobile.Helpers"
             x:Class="GigRadarMobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="PrimaryColor">#39FF14</Color>
            <Color x:Key="SecondaryColor">#7B2FFF</Color>
            <Color x:Key="BackgroundColor">#121212</Color>
            <Color x:Key="SurfaceColor">#1E1E1E</Color>
            <Color x:Key="CardColor">#2A2A2A</Color>
            <Color x:Key="TextPrimary">#FFFFFF</Color>
            <Color x:Key="TextSecondary">#B0B0B0</Color>
            <helpers:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <helpers:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
            <helpers:IsZeroConverter x:Key="IsZeroConverter"/>
            <helpers:BarcodeDrawableConverter x:Key="BarcodeDrawableConverter"/>
            <Style TargetType="NavigationPage">
                <Setter Property="BarBackgroundColor" Value="#121212"/>
                <Setter Property="BarTextColor" Value="#39FF14"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
